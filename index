        });
        tcur += mn;
      });
      var bh = (b - a) / 60 * self.HH;
      var avail = bh - 20;
      // plages hautes (Fajr, ʿIshāʾ) : les 4 étapes en 2×2 ; plages courtes : départ + iqāma
