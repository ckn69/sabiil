        { k: 'cours', label: 'Cours' }, { k: 'coran', label: 'Coran' }, { k: 'livre', label: 'Livres' }
      ].map(function (c) {
        var on = fil === c.k;
        return {
          label: c.label, num: counts[c.k],
          bg: on ? '#1A1610' : '#fff', ink: on ? '#fff' : '#6B6759',
          border: on ? '#1A1610' : '#E4E1D8',
          numInk: on ? 'rgba(255,255,255,.55)' : '#B6B1A5',
          pick: function () { self.setState({ ntFilter: c.k }); }
        };
      }),
      ntRows: rows.map(function (n, ix) {
        var m = self.NT_CATS[n.kind] || self.NT_CATS.libre, c = self.tint(m.cat);
        var body = n.body.replace(/\s+/g, ' ').trim();
        return {
          title: n.title,
          snippet: body.length > 110 ? body.slice(0, 110) + '…' : body,
          src: m.label, srcBg: c.bg, srcInk: c.ink,
          stamp: n.ts ? self.ntStamp(n.ts) : '',
          stampShow: n.ts ? 'block' : 'none',
          divider: ix === rows.length - 1 ? 'none' : '1px solid #EFEDE6',
          open: function () {
            self.setState({ ntEdit: n, ntTitle: n.title === 'Note sans titre' ? '' : n.title, ntBody: n.body });
          }
        };
      }),
      ntEmptyShow: rows.length ? 'none' : 'block',
      ntEmptyTxt: all.length ? 'Aucune note ne correspond à cette recherche.' : 'Aucune note pour l\'instant. Crée ta première note, ou écris depuis un cours, le Coran ou un livre.',
      ntNew: function () {
        self.setState({ ntEdit: { id: '', kind: 'libre', title: '', body: '', ts: 0, isNew: true }, ntTitle: '', ntBody: '' });
      },
      ntBack: function () { self.setState({ ntEdit: null }); },
      ntGoToday: function () { self.setState({ screen: 'today', ntEdit: null }); },
      ntTitle: st.ntTitle || '',
      ntBody: st.ntBody || '',
      ntSetTitle: function (e) { self.setState({ ntTitle: e.target.value }); },
      ntSetBody: function (e) { self.setState({ ntBody: e.target.value }); },
      ntIsFree: !!(ed && ed.kind === 'libre'),
      ntIsLinked: !!(ed && ed.kind !== 'libre'),
      ntEdTitle: ed ? ed.title : '',
      ntEdBody: ed ? ed.body : '',
      ntEdSrc: ed ? edMeta.label : '',
      ntEdSrcBg: ed ? edTint.bg : '#fff',
      ntEdSrcInk: ed ? edTint.ink : '#6B6759',
      ntEdStamp: ed && ed.ts ? self.ntStamp(ed.ts) : 'Nouvelle note',
      ntHeaderTitle: ed && ed.isNew ? 'Nouvelle note' : 'Note',
      ntDelShow: ed && ed.kind === 'libre' && !ed.isNew ? 'block' : 'none',
      ntSave: function () {
        var body = st.ntBody || '', title = (st.ntTitle || '').trim();
        if (!body.trim() && !title) { self.toast('Note vide'); return; }
        var list = (st.ntList || []).slice();
        if (ed.isNew) {
          list = [{ id: 'n' + Date.now(), title: title, body: body, ts: Date.now() }].concat(list);
        } else {
