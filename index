  // ═══ cartes ═══
  fcPatch(p) { this.setState({ fc: Object.assign({}, this.state.fc, p) }); }

  fcStart(deckId) {
    var q = [];
    this.state.decks.forEach(function (d) {
      if (deckId && d.id !== deckId) return;
      d.cards.forEach(function (c) { if (c.due <= 0) q.push({ d: d.id, c: c.id }); });
    });
    if (!q.length) { this.toast('Aucune carte à revoir pour le moment'); return; }
    this.fcPatch({ view: 'study', deck: deckId, queue: q, qi: 0, back: false, again: 0, ok: 0 });
  }

  fcIv(c, k) {
    var iv = c ? (c.iv || 0) : 0;
    if (k === 'again') return 0;
    if (k === 'hard') return iv ? Math.max(1, Math.round(iv * 1.2)) : 1;
    if (k === 'good') return iv ? Math.max(2, Math.round(iv * 2.4)) : 3;
    return iv ? Math.max(4, Math.round(iv * 3.5)) : 7;
  }

  fcGrade(k) {
    var self = this, st = this.state, fc = st.fc, item = fc.queue[fc.qi];
    if (!item) return;
    var card = null;
    st.decks.forEach(function (d) { if (d.id === item.d) d.cards.forEach(function (c) { if (c.id === item.c) card = c; }); });
    var ni = this.fcIv(card, k);
    var decks = st.decks.map(function (d) {
      if (d.id !== item.d) return d;
      return Object.assign({}, d, {
        cards: d.cards.map(function (c) {
          if (c.id !== item.c) return c;
          return Object.assign({}, c, { iv: ni, due: ni, reps: c.reps + 1 });
        })
      });
    });
    var queue = fc.queue.slice(), qi = fc.qi + 1, again = fc.again, ok = fc.ok;
    if (k === 'again') { queue.push(item); again++; } else { ok++; }
    this.setState({
      decks: decks,
      fc: Object.assign({}, fc, { queue: queue, qi: qi, back: false, again: again, ok: ok, view: qi >= queue.length ? 'done' : 'study' })
    });
  }

  cardVals() {
    var self = this, st = this.state, fc = st.fc;
    var dueTotal = 0, fresh = 0, learned = 0;
    st.decks.forEach(function (d) {
      d.cards.forEach(function (c) {
        if (c.due <= 0) dueTotal++;
        if (c.reps === 0) fresh++;
        if (c.iv >= 21) learned++;
      });
    });
    var item = fc.queue[fc.qi] || null;
    var deck = null, card = null;
    st.decks.forEach(function (d) {
      if (item && d.id === item.d) { deck = d; d.cards.forEach(function (c) { if (c.id === item.c) card = c; }); }
    });
    var dl = st.decks.length - 1;
    var CATS = [
      { k: 'arabe', label: 'Arabe' }, { k: 'coran', label: 'Coran' }, { k: 'sciences', label: 'Sciences' },
      { k: 'mosquee', label: 'Mosquée' }, { k: 'personnel', label: 'Personnel' }
    ];
    var ivLabel = function (k) {
      var n = self.fcIv(card, k);
      return n === 0 ? '< 1 min' : (n === 1 ? '1 jour' : n + ' jours');
    };
    var cd = fc.cardDraft, dd = fc.deckDraft;
    var deckName = '';
    st.decks.forEach(function (d) { if (d.id === cd.deck) deckName = d.name; });

    return {
      fcListShow: fc.view === 'list', fcStudyShow: fc.view === 'study', fcDoneShow: fc.view === 'done',
      fcDueTotal: dueTotal, fcMinutes: Math.max(1, Math.round(dueTotal * 0.4)),
