  adhVals() {
    var self = this, st = this.state, q = (st.adhQuery || '').trim().toLowerCase();
    var all = this.ADH, fav = st.adhFav || {};
    var open = null;
    all.forEach(function (c) { if (c.n === st.adhChap) open = c; });
    var typed = 0;
    all.forEach(function (c) { if (c.it) typed += 1; });

    var list = all.filter(function (c) {
      if (!q) return true;
      return c.fr.toLowerCase().indexOf(q) >= 0 || c.ar.indexOf(q) >= 0 || String(c.n) === q;
    });

    var favRows = [];
    Object.keys(fav).forEach(function (k) {
      var parts = k.split('-'), cn = parseInt(parts[0], 10), dn = parseInt(parts[1], 10);
      all.forEach(function (c) {
        if (c.n !== cn || !c.it) return;
        c.it.forEach(function (d) {
          if (d.n !== dn) return;
          favRows.push({
            ar: d.ar || (d.q ? d.q.ar : ''), chap: c.n + ' · ' + c.fr,
            go: function () { self.setState({ adhChap: c.n }); }
          });
        });
      });
    });

    var items = open && open.it ? open.it.map(function (d, ix) {
      var key = open.n + '-' + d.n, on = !!fav[key];
      var qk = key + '-q', qs = (d.q && (st.adhQ || {})[qk]) || {};
      var qverses = (qs.v || []).map(function (v, vi) {
        return { ar: v.t, num: self.arNum(v.n), top: vi === 0 ? 'none' : '1px solid #EDE4D0' };
      });
      return {
        num: String(d.n).padStart(2, '0'),
        ar: d.ar || '', hasAr: !!d.ar,
        isQ: !!d.q, qAr: d.q ? d.q.ar : '', qFr: d.q ? d.q.fr : '',
        qVerses: qverses,
        qLoadShow: qs.loading ? 'block' : 'none',
        qErrShow: qs.err ? 'block' : 'none',
        qRef: function (el) { if (el && d.q) self.adhLoadQ(qk, d.q); },
        qRetry: function () {
          if (!d.q) return;
          var m = Object.assign({}, self.state.adhQ); delete m[qk];
          self.setState({ adhQ: m }, function () { self.adhLoadQ(qk, d.q); });
        },
        page: d.p || open.p,
        rep: d.rep || '', hasRep: !!d.rep,
        note: d.note || '', hasNote: !!d.note,
        src: d.src || '', hasSrc: !!d.src,
        favBg: on ? '#F7EFDD' : '#fff', favFill: on ? '#8A5E1F' : 'none', favStroke: on ? '#8A5E1F' : '#C9C4B8',
        toggleFav: function () { self.adhToggleFav(key); },
        openPdf: function () { self.adhOpenPdf(d.p || open.p); },
        copy: function () {
          var t = d.ar || qverses.map(function (v) { return v.ar; }).join(' ') || (d.q ? d.q.ar : '');
          if (t && navigator.clipboard) { navigator.clipboard.writeText(t).catch(function () {}); self.toast('Dhikr copié'); }
          else self.toast('Copie indisponible');
        }
      };
    }) : [];

    return {
      adh: {
        isList: !open, isRead: !!open,
        chapCount: all.length, doneLabel: typed + ' chapitres saisis',
        shownLabel: q ? list.length + ' résultats' : all.length + ' chapitres',
        noHit: list.length === 0,
        q: st.adhQuery || '',
        setQ: function (e) { self.setState({ adhQuery: e.target.value }); },
        openBook: function () { self.adhOpenPdf(1); },
        hasFav: favRows.length > 0, favs: favRows.map(function (f, ix) {
          return { ar: f.ar, chap: f.chap, go: f.go, divider: ix === favRows.length - 1 ? 'none' : '1px solid #EFEDE6' };
        }),
        chapters: list.map(function (c, ix) {
          var has = !!c.it;
          return {
            num: String(c.n).padStart(2, '0'), ar: c.ar, fr: c.fr,
            chip: has ? (c.it.length + (c.it.length > 1 ? ' adhkār' : ' dhikr')) : 'p. ' + c.p,
            chipBg: has ? 'var(--sb-abg)' : '#EFEDE6',
            chipBorder: has ? 'var(--sb-abd)' : '#EFEDE6',
            chipInk: has ? 'var(--sb-ai)' : '#8A8578',
            divider: ix === list.length - 1 ? 'none' : '1px solid #EFEDE6',
            go: function () { self.setState({ adhChap: c.n }); }
          };
        }),
        chapAr: open ? open.ar : '', chapFr: open ? open.fr : '',
        chapNum: open ? open.n : '', chapPage: open ? open.p : '',
        items: items, pending: !!open && !open.it,
        back: function () { self.setState({ adhChap: null }); },
        openChapPdf: function () { if (open) self.adhOpenPdf(open.p); },
        prevOp: open && open.n > 1 ? '1' : '.4',
        nextOp: open && open.n < all.length ? '1' : '.4',
        prev: function () { if (open && open.n > 1) self.setState({ adhChap: open.n - 1 }); },
        next: function () { if (open && open.n < all.length) self.setState({ adhChap: open.n + 1 }); }
      }
    };
  }

