      var raw = window.localStorage.getItem('sabil.mushaf.meta.v2');
      if (raw) { var d = JSON.parse(raw); if (d && d.basmalah) { this._qmMeta = d; return Promise.resolve(d); } }
    } catch (e) {}
    var a = fetch(this.QM_API + '/chapters?language=ar').then(function (r) { return r.json(); });
    var b = fetch(this.QM_API + '/verses/by_key/1:1?fields=text_uthmani').then(function (r) { return r.json(); });
    return Promise.all([a, b]).then(function (x) {
