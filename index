    var diff = Math.round((t - d) / 86400000);
    if (diff <= 0) return 'Aujourd\'hui';
    if (diff === 1) return 'Hier';
    return this.DOWS[(d.getDay() + 6) % 7] + ' ' + d.getDate() + ' ' + this.MONTHS[d.getMonth()].toLowerCase();
