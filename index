      nbStart: st.nb.start, nbEnd: st.nb.end, times: times, nbDurLabel: nbDurLabel,
      setNbStart: function (e) {
        var v = parseInt(e.target.value, 10);
        var d = st.nb.end - st.nb.start;
        self.setState({ nb: Object.assign({}, st.nb, { start: v, end: Math.min(1440, v + Math.max(15, d)) }) });
      },
      setNbEnd: function (e) {
        var v = parseInt(e.target.value, 10);
        self.setState({ nb: Object.assign({}, st.nb, { end: Math.max(st.nb.start + 15, v) }) });
      },
      nbActions: nbActions, nbRecs: nbRecs,

      isCatSheet: st.modal === 'cats',
      openCatSheet: function () { self.setState({ modal: 'cats' }); },
      backToBlock: function () { self.setState({ modal: 'block' }); },
      catRows: this.catRowsFor(ALLACTS, CM),
      catName: st.catDraft.name,
      setCatName: function (e) {
        var v = e.target.value;
        self.setState(function (s) { return { catDraft: Object.assign({}, s.catDraft, { name: v }) }; });
      },
      catPals: this.PAL.map(function (p) {
        var on = st.catDraft.pal === p.k;
        return {
          bg: p.bar, label: p.label,
          ring: on ? '0 0 0 2px #F7F6F2, 0 0 0 3.5px ' + p.bar : 'none',
          pick: function () { self.setState(function (s) { return { catDraft: Object.assign({}, s.catDraft, { pal: p.k }) }; }); }
        };
      }),
      catIcons: ['star', 'target', 'note', 'cup', 'habit', 'grad', 'kids', 'clock'].map(function (k) {
        var on = st.catDraft.ic === k;
        return {
          d: self.IC[k][0], d2: self.IC[k][1],
          bg: on ? '#1A1610' : '#fff', ink: on ? '#fff' : '#6B6759',
          border: on ? '#1A1610' : '#E4E1D8',
          pick: function () { self.setState(function (s) { return { catDraft: Object.assign({}, s.catDraft, { ic: k }) }; }); }
        };
      }),
      catAdd: function () { self.catAdd(); },

      nbOwners: nbOwners, ownerIsKid: ownerIsKid,
      ownerKidName: ownerKid ? ownerKid.name : '',
      ownerNote: ownerKid ? 'Ce bloc ira dans l\'agenda de ' + ownerKid.name + ', visible en calque sur le tien.' : '',
      nbRewardTitle: nbAct.title, nbHadith: '« ' + nbAct.hadith + ' »', nbHadithSrc: nbAct.src,
      saveBlock: function () {
        var name = (st.nb.name || '').trim();
        if (!name) { self.toast('Donne un nom au bloc'); return; }
        var nb = st.nb;
        if ((nb.owner || 'me') !== 'me') {
          var kid = null;
          self.KIDS.forEach(function (k) { if (k.id === nb.owner) kid = k; });
          if (kid) {
            kid.blocks = kid.blocks.concat([{ id: Date.now(), name: name, s: nb.start, e: nb.end, cat: nb.cat, ic: nb.ic }]);
            var sh = Object.assign({}, st.kidsShown); sh[kid.id] = true;
            self.setState({
              modal: '', kidsOn: true, kidsShown: sh,
              nb: { name: '', autoName: true, start: 840, end: 900, act: 'coran', ic: 'coran', cat: 'coran', rec: 'once', date: nb.date, owner: nb.owner, editing: null }
            });
            self.toast(name + ' · agenda de ' + kid.name);
            return;
          }
        }
        var ev = Object.assign({}, st.events);
        var targets = [nb.date];
        if (nb.rec === 'daily') {
          targets = self.weekKeys(nb.date);
        } else if (nb.rec === 'weekly') {
          targets = [0, 1, 2, 3].map(function (w) { return self.addDays(nb.date, w * 7); });
        }
        if (nb.editing) {
          var old = ev[nb.editing.dk] || [];
          ev[nb.editing.dk] = old.filter(function (x) { return x.id !== nb.editing.id; });
        }
        var base = Date.now();
        var made = [];
        targets.forEach(function (k, i) {
          var item = { id: base + i, name: name, s: nb.start, e: nb.end, cat: nb.cat, ic: nb.ic,
            rem: nb.rem === undefined ? -1 : nb.rem, loc: (nb.loc || '').trim(),
            note: (nb.note || '').trim(), tel: (nb.tel || '').trim() };
          ev[k] = (ev[k] || []).concat([item]);
          made.push({ dk: k, item: item });
        });
        if (nb.editing) self.nActCancel(nb.editing.dk, nb.editing.id);
        self.setState({
          events: ev, modal: '', cur: targets.indexOf(st.cur) !== -1 ? st.cur : nb.date,
          nb: { name: '', start: 840, end: 900, ic: 'coran', cat: 'coran', rec: 'once', date: nb.date, editing: null,
            rem: nb.rem, loc: '', note: '', tel: '', agenda: nb.agenda }
        });
        made.forEach(function (m) { self.nActSync(m.dk, m.item); });
        if (nb.agenda && made.length) self.nToAgenda(made[0].dk, made[0].item, true);
        self.toast(nb.editing ? name + ' modifié' : (targets.length > 1 ? name + ' · ' + targets.length + ' occurrences' : name + ' · ' + self.hhmm(nb.start) + ' → ' + self.hhmm(nb.end)));
      },

      nav: nav, toast: st.toast,
      goToday: function () { self.setState({ screen: 'today' }); },
      streakToast: function () { self.toast('23 jours consécutifs'); },
      focusToast: function () { self.toast('Mode focus — porté à la prochaine étape'); },
      agendaToast: function () { self.toast('Navigation entre les jours — à venir'); },
      weekTemplateToast: function () { self.toast('Semaine type — portée à la prochaine étape'); },

      stopEvt: function (e) { if (e && e.stopPropagation) e.stopPropagation(); },
      closeSheet: function () { self.closeSheet(); }
    };
    Object.assign(out, this.mushafVals(), this.readerVals(), this.moutounVals(), this.cardVals(), this.adhVals(), this.notifVals(), this.ntVals());
    return out;
  }
}

</script>
