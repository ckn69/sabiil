  // Mise à l'échelle : une seule taille de police par page (comme au mushaf),
  // calée sur la hauteur disponible ET sur la ligne la plus large. Jamais de déformation.
  qmFit() {
    var self = this, host = this._qmHost, pg = this.qmGet(this.state.mi);
    if (!host || !pg) return;
    var W = host.clientWidth, H = host.clientHeight;
    if (!W || !H) return;
    var run = function () {
      var probe = self._qmProbe;
      if (!probe || !probe.parentNode) {
        probe = self._qmProbe = document.createElement('div');
        probe.style.cssText = 'position:absolute;left:-9999px;top:0;visibility:hidden;pointer-events:none;' +
          'white-space:nowrap;direction:rtl;line-height:1;display:inline-flex;align-items:center;gap:0.16em;' +
          'font-size:100px;font-family:' + self.QM_FAM;
        document.body.appendChild(probe);
      }
      var base = 100, nat = {}, widest = 1;
      pg.lines.forEach(function (l) {
        if (l.type !== 'text') return;
        var html = '';
        l.words.forEach(function (w) {
          if (w.end) html += '<span style="display:inline-flex;flex-shrink:0;width:1.5em;height:1.5em;margin:0 0.1em;font-size:0.44em"></span>';
          else html += '<span style="display:inline-block;padding:0 0.02em">' + w.t + '</span>';
        });
        probe.innerHTML = html;
        var wd = probe.offsetWidth;
        nat[l.i] = wd;
        if (wd > widest) widest = wd;
      });
      probe.innerHTML = '';
      var cap = (H / 15) * 0.62;                                   // plafond imposé par les 15 lignes
      var font = Math.max(9, Math.round(Math.min(cap, base * (W * 0.995) / widest) * 10) / 10);
      // page contrainte par la hauteur (écran court) : lignes centrées, aucune gouttière parasite.
      // page contrainte par la largeur (cas normal) : justification pleine largeur, comme au mushaf.
      var heightBound = widest * font / base < W * 0.92;
      var sizes = {}, just = {};
      pg.lines.forEach(function (l) {
        if (l.type !== 'text') return;
        var n = nat[l.i] || 1;
        var sz = Math.max(9, Math.round(Math.min(cap, base * (W * 0.995) / n) * 10) / 10);
        sizes[l.i] = sz;
        just[l.i] = (!heightBound && n * sz / base > W * 0.62) ? 'space-between' : 'center';
      });
      var prev = self.state.qmLay;
      if (prev && prev.page === pg.p && Math.abs(prev.font - font) < 0.2) return;
      self.setState({ qmLay: { font: font, sizes: sizes, just: just, page: pg.p } });
    };
    if (document.fonts && document.fonts.load) {
      document.fonts.load("100px 'Amiri Quran'").then(run, run);
    } else run();
  }

  qmAyahText(key) {
