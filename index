            <svg viewBox="0 0 24 24" style="width:12px;height:12px;fill:none;stroke:#4F4B40;stroke-width:2.6;stroke-linecap:round"><path d="M5.5 12h13"></path></svg>
          </button>
          <div style="font-size:16px;font-weight:700;font-variant-numeric:tabular-nums;min-width:16px;text-align:center">{{ fastNote.count }}</div>
          <button onClick="{{ fastNote.inc }}" style="width:26px;height:26px;border-radius:8px;border:1px solid #E4E1D8;background:#F7F6F2;display:flex;align-items:center;justify-content:center">
            <svg viewBox="0 0 24 24" style="width:12px;height:12px;fill:none;stroke:#4F4B40;stroke-width:2.6;stroke-linecap:round"><path d="M12 5.5v13M5.5 12h13"></path></svg>
