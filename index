  // Décalage observé entre les annonces des différentes autorités
  HIJRI_OFFSET = { FR: 0, DZ: 0, TN: 0, MA: 1, SA: -1, EG: -1 };

  // Mois enregistrés. gregorianStartDate = null ⇒ aucune annonce ⇒ pending.
  HIJRI_BASE = [
    { y: 1447, m: 10, g: '2026-03-21', ann: '2026-03-19',
      text: 'Le croissant de Shawwāl a été observé. Le 1er Shawwāl 1447 et l\'ʿAïd al-Fiṭr correspondent au {DATE}.' },
    { y: 1447, m: 11, g: '2026-04-19', ann: '2026-04-17',
