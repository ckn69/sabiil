    { y: 1448, m: 1, g: null, ann: null, text: null }
  ];

  hijriCountryInfo(code) {
    for (var i = 0; i < this.HIJRI_COUNTRIES.length; i++) {
      if (this.HIJRI_COUNTRIES[i].code === code) return this.HIJRI_COUNTRIES[i];
    }
    return this.HIJRI_COUNTRIES[0];
  }

  gLabelLong(key) {
    if (!key) return '';
    var d = this.pd(key);
    return this.DOWS[this.mdow(key)].toLowerCase() + ' ' + d.getDate() + ' ' +
      this.MONTHS[d.getMonth()].toLowerCase() + ' ' + d.getFullYear();
  }

  // Modèle de données officiel, par pays
  hijriRecords(code) {
    var self = this, c = this.hijriCountryInfo(code), off = this.HIJRI_OFFSET[code] || 0;
    return this.HIJRI_BASE.map(function (b) {
      var g = b.g ? self.addDays(b.g, off) : null;
      var txt = null;
      if (g && b.text) {
        txt = b.text
          .split('{DATE}').join(self.gLabelLong(g))
          .split('{ARAFA}').join(self.gLabelLong(self.addDays(g, 8)))
          .split('{EID}').join(self.gLabelLong(self.addDays(g, 9)));
      }
      return {
        country: code,
        hijriMonth: b.m,
        hijriYear: b.y,
        monthName: self.HIJRI_MONTHS_FR[b.m - 1],
        gregorianStartDate: g,
        status: g ? 'confirmed' : 'pending',
        authority: c.authority,
        sourceUrl: g ? c.sourceUrl : null,
        announcementDate: b.ann ? self.addDays(b.ann, off) : null,
        announcementText: txt,
        verificationMethod: g ? 'official_announcement' : null
      };
    });
  }

  // Coucher du soleil réel pour la localisation (algorithme solaire NOAA)
  sunsetMin(key) {
    var pl = this.state.place, p = key.split('-');
    var Y = +p[0], M = +p[1], D = +p[2];
    var rad = function (x) { return x * Math.PI / 180; };
    var deg = function (x) { return x * 180 / Math.PI; };
    var norm = function (x, n) { x = x % n; return x < 0 ? x + n : x; };
    var N = Math.round((Date.UTC(Y, M - 1, D) - Date.UTC(Y, 0, 0)) / 86400000);
    var lngHour = pl.lng / 15;
    var t = N + ((18 - lngHour) / 24);
    var Mm = (0.9856 * t) - 3.289;
    var L = norm(Mm + (1.916 * Math.sin(rad(Mm))) + (0.020 * Math.sin(rad(2 * Mm))) + 282.634, 360);
    var RA = norm(deg(Math.atan(0.91764 * Math.tan(rad(L)))), 360);
    RA = (RA + ((Math.floor(L / 90) * 90) - (Math.floor(RA / 90) * 90))) / 15;
    var sinDec = 0.39782 * Math.sin(rad(L));
    var cosDec = Math.cos(Math.asin(sinDec));
    var cosH = (Math.cos(rad(90.833)) - (sinDec * Math.sin(rad(pl.lat)))) / (cosDec * Math.cos(rad(pl.lat)));
    if (cosH > 1 || cosH < -1) return null;
    var H = deg(Math.acos(cosH)) / 15;
    var UT = norm(H + RA - (0.06571 * t) - 6.622 - lngHour, 24);
    return Math.round(norm(UT + pl.tz, 24) * 60);
  }

  maghribMin(key) {
    var s = this.sunsetMin(key);
    if (s === null) return 1294;
    return s;
  }

  // Résolution : jour grégorien du jour islamique → date Hijri officielle
  hijriResolve(gregKey, code) {
    var recs = this.hijriRecords(code).filter(function (r) { return r.gregorianStartDate; });
    recs.sort(function (a, b) { return a.gregorianStartDate < b.gregorianStartDate ? -1 : 1; });
    var found = null;
    for (var i = 0; i < recs.length; i++) {
      if (recs[i].gregorianStartDate <= gregKey) found = recs[i];
    }
    var pending = this.hijriRecords(code).filter(function (r) { return r.status === 'pending'; })[0] || null;
    if (!found) return { status: 'pending', rec: null, awaiting: pending };
    var day = Math.round((this.pd(gregKey) - this.pd(found.gregorianStartDate)) / 86400000) + 1;
    // un mois lunaire ne dépasse jamais 30 jours : au-delà, il faut une nouvelle annonce
    if (day > 30) return { status: 'pending', rec: null, awaiting: pending, prev: found };
    return {
      status: 'confirmed', day: day, month: found.hijriMonth, year: found.hijriYear,
      monthName: found.monthName,
      label: day + ' ' + found.monthName + ' ' + found.hijriYear,
      shortLabel: day + ' ' + found.monthName,
      rec: found, awaiting: pending
    };
  }

  // Libellé Hijri d'un jour du calendrier (journée, hors bascule Maghrib)
  hijriDayLabel(key, withYear) {
    var r = this.hijriResolve(key, this.state.hijriCountry);
    if (r.status !== 'confirmed') return 'Date en attente';
    return withYear ? r.label : r.shortLabel;
  }

  hijriDayNum(key) {
    var r = this.hijriResolve(key, this.state.hijriCountry);
    return r.status === 'confirmed' ? r.day : '—';
  }

  hijriClockNow() {
    var clock = this.state.hijriClock;
    if (clock === null || clock === undefined) return { key: this.TODAY_KEY, min: this.NOW };
    var off = Math.floor(clock / 1440);
    return { key: this.addDays(this.TODAY_KEY, off), min: clock - (off * 1440) };
  }

  // État courant : date officielle + moment de la journée islamique
  hijriNow() {
    var c = this.hijriClockNow();
    var mg = this.maghribMin(c.key);
    var after = c.min >= mg;
    var islamicKey = after ? this.addDays(c.key, 1) : c.key;
    return {
      code: this.state.hijriCountry,
      country: this.hijriCountryInfo(this.state.hijriCountry),
      gregKey: c.key, min: c.min, maghrib: mg, after: after,
      islamicKey: islamicKey,
      res: this.hijriResolve(islamicKey, this.state.hijriCountry)
    };
  }

  patchEvent(dk, id, patch) {
    var ev = Object.assign({}, this.state.events);
    ev[dk] = (ev[dk] || []).map(function (x) { return x.id === id ? Object.assign({}, x, patch) : x; });
    this.setState({ events: ev });
  }

  removeEvent(dk, id) {
    this.nActCancel(dk, id);
    var ev = Object.assign({}, this.state.events);
    ev[dk] = (ev[dk] || []).filter(function (x) { return x.id !== id; });
    this.setState({ events: ev, detail: null });
  }

  // appui maintenu ~0,5 s : déclenche fn (aucun effet si le doigt bouge ou se relève avant)
  longPress(e, fn) {
    if (e.button !== undefined && e.button !== 0) return;
    var self = this, x0 = e.clientX, y0 = e.clientY;
    var mv, up;
    var clear = function () {
      if (self._lpT) { clearTimeout(self._lpT); self._lpT = null; }
      window.removeEventListener('pointermove', mv);
      window.removeEventListener('pointerup', up);
      window.removeEventListener('pointercancel', up);
    };
    mv = function (m) { if (Math.abs(m.clientY - y0) > 7 || Math.abs(m.clientX - x0) > 7) clear(); };
    up = function () { clear(); };
    window.addEventListener('pointermove', mv);
    window.addEventListener('pointerup', up);
    window.addEventListener('pointercancel', up);
    this._lpT = setTimeout(function () { self._lpT = null; clear(); self._noclick = Date.now(); fn(); }, 500);
  }

  startDrag(e, item, mode) {
    this.adjKeep();
    if (e.button !== undefined && e.button !== 0) return;
    e.preventDefault();
    e.stopPropagation();
    var self = this, y0 = e.clientY, s0 = item.s, e0 = item.e, dk = this.state.cur;
    var moved = false, ns = s0, ne = e0;
    var perMin = this.HH / 60;
    var move = function (me) {
      var dm = Math.round((me.clientY - y0) / perMin / 5) * 5;
      if (!moved && Math.abs(me.clientY - y0) < 4) return;
      moved = true;
      if (mode === 'move') {
        ns = s0 + dm; ne = e0 + dm;
        if (ns < 0) { ne += -ns; ns = 0; }
        if (ne > 1440) { ns -= ne - 1440; ne = 1440; }
      } else if (mode === 'resize') {
        ns = s0; ne = Math.max(s0 + 15, Math.min(1440, e0 + dm));
      } else {
        ne = e0; ns = Math.max(0, Math.min(e0 - 15, s0 + dm));
      }
      self.patchEvent(dk, item.id, { s: ns, e: ne });
    };
    var up = function () {
      window.removeEventListener('pointermove', move);
      window.removeEventListener('pointerup', up);
      self.setState({ dragging: null });
      if (moved) { self._noclick = Date.now(); self.toast(item.name + ' · ' + self.hhmm(ns) + ' → ' + self.hhmm(ne)); }
    };
    window.addEventListener('pointermove', move);
    window.addEventListener('pointerup', up);
    this.setState({ dragging: item.id });
  }

  kidDrag(e, kid, b, mode) {
    this.adjKeep();
    if (e.button !== undefined && e.button !== 0) return;
    e.preventDefault();
    e.stopPropagation();
    var self = this, y0 = e.clientY, s0 = b.s, e0 = b.e, perMin = this.HH / 60, moved = false;
    var move = function (me) {
      var dm = Math.round((me.clientY - y0) / perMin / 5) * 5;
      if (!moved && Math.abs(me.clientY - y0) < 4) return;
      moved = true;
      if (mode === 'move') {
        var ns = s0 + dm, ne = e0 + dm;
        if (ns < 0) { ne += -ns; ns = 0; }
        if (ne > 1440) { ns -= ne - 1440; ne = 1440; }
        b.s = ns; b.e = ne;
      } else if (mode === 'resize') {
        b.e = Math.max(s0 + 15, Math.min(1440, e0 + dm));
      } else {
        b.s = Math.max(0, Math.min(e0 - 15, s0 + dm));
      }
      self.forceUpdate();
    };
    var up = function () {
      window.removeEventListener('pointermove', move);
      window.removeEventListener('pointerup', up);
      if (moved) {
        self._noclick = Date.now();
        self.toast(kid.name + ' · ' + b.name + ' · ' + self.hhmm(b.s) + ' → ' + self.hhmm(b.e));
      }
    };
    window.addEventListener('pointermove', move);
    window.addEventListener('pointerup', up);
  }

  // un appui n'importe où ailleurs valide la modification et referme le mode
  adjKeep() { this._adjKeep = Date.now(); }

  adjOutsideOn() {
    if (this._adjDoc) return;
    var self = this;
    this._adjDoc = function () {
      if (Date.now() - (self._adjKeep || 0) < 120) return;
      if (!self.state.adj) return;
      self.setState({ adj: null });
    };
    window.addEventListener('pointerdown', this._adjDoc);
  }

  adjOutsideOff() {
    if (!this._adjDoc) return;
    window.removeEventListener('pointerdown', this._adjDoc);
    this._adjDoc = null;
  }

  toggleAdj(a) {
    var c = this.state.adj;
    var same = c && c.kind === a.kind && c.id === a.id && c.dk === a.dk && c.kidId === a.kidId;
    if (same) { this.setState({ adj: null }); return; }
    this.setState({ adj: a, detail: null });
  }

  // activité de référence d'un bloc (icône puis catégorie) — source des infos générales
  actFor(ev) {
    var found = null;
    this.ACTIONS.forEach(function (a) { if (!found && ev.ic && a.ic === ev.ic) found = a; });
    if (!found) this.ACTIONS.forEach(function (a) { if (!found && a.cat === ev.cat) found = a; });
    return found;
  }

  remLabel(r) {
    if (r === undefined || r === null || r < 0) return '';
    if (r === 0) return "À l'heure";
    return r >= 60 ? (r / 60) + ' h avant' : r + ' min avant';
  }

  openNew(date, start) {
    this.setState({
      modal: 'block',
      nb: Object.assign({}, this.state.nb, {
        name: '', autoName: true, date: date, start: start, end: Math.min(1440, start + 60), editing: null, rec: 'once',
        rem: this.nP().actReminder ? this.nP().actDefault : -1, loc: '', note: '', tel: '', agenda: this.nP().autoAgenda === true
      })
    });
  }

  bufOf(n) { return (this.state.buf || {})[n] || { travel: 10, adhan: 10, prayer: 10, adkars: 15 }; }
  bufBefore(n) { var b = this.bufOf(n); return b.travel; }
  bufAfter(n) { var b = this.bufOf(n); return b.adhan + b.prayer + b.adkars; }

  bands(PR) {
    var self = this;
    return PR.map(function (p) {
      return { n: p.n, a: Math.max(0, p.m - self.bufBefore(p.n)), b: Math.min(1440, p.m + self.bufAfter(p.n)) };
    });
  }

  // Déclaration du module dans PROG (source des valeurs de repli)
  modDecl(name) {
    var found = null;
    var self = this;
    Object.keys(this.PROG).forEach(function (pk) {
      self.PROG[pk].levels.forEach(function (lv) {
        lv.modules.forEach(function (m) { if (m.name === name) found = m; });
      });
    });
    return found;
  }

  courseOf(name) {
    if (this.COURSE[name]) return this.COURSE[name];
    var decl = this.modDecl(name);
    var n = decl ? decl.total : 6;
    var ls = [];
    for (var i = 0; i < n; i++) ls.push({ t: 'Leçon ' + (i + 1), d: 330 });
    return { lessons: ls, fiche: [], qcm: [], generic: true };
  }

  // Unique source de vérité : COURSE.lessons + listened (amorcé par PROG.done)
  modInfo(name) {
    var c = this.courseOf(name);
    var decl = this.modDecl(name);
    var self = this;
    var seed = decl ? (decl.done || 0) : 0;
    var done = 0;
    for (var i = 0; i < c.lessons.length; i++) if (this.heard(name, i, seed)) done++;
    var durLabel;
    if (c.generic && decl && decl.dur) durLabel = decl.dur;
    else {
      var sec = c.lessons.reduce(function (a, l, ix) { return a + self.lessonDur(name, ix, l); }, 0);
      var h = Math.floor(sec / 3600), mn = Math.round((sec % 3600) / 60);
      durLabel = sec ? (h ? h + 'h ' + String(mn).padStart(2, '0') : mn + ' min') : '';
    }
    return { total: c.lessons.length, done: done, dur: durLabel, src: decl ? decl.src : '', seed: seed };
  }

  heard(name, i, seed) {
    if (this.state.listened[name + '|' + i]) return true;
    if (seed === undefined) {
      var d = this.modDecl(name);
      seed = d ? (d.done || 0) : 0;
    }
    return i < seed;
  }

  mmss(s) {
    s = Math.max(0, Math.round(s));
    return Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0');
  }

  CKEY = 'sabil.courses.v1';

  lKey(course, i) { return course + '|' + i; }

  lessonDur(course, i, l) {
    return this.state.cdur[this.lKey(course, i)] || (l && l.d) || 0;
  }

  cStore() {
    try { return JSON.parse(window.localStorage.getItem(this.CKEY)) || {}; } catch (e) { return {}; }
  }

  cSave(patch) {
    var s = this.cStore();
    Object.keys(patch).forEach(function (k) { s[k] = patch[k]; });
    try { window.localStorage.setItem(this.CKEY, JSON.stringify(s)); } catch (e) {}
  }

  audioEl() {
    if (this._au) return this._au;
    var self = this;
    var a = new window.Audio();
    a.preload = 'metadata';
    a.addEventListener('loadedmetadata', function () { self.onAudioMeta(); });
    a.addEventListener('timeupdate', function () { self.onAudioTime(); });
    a.addEventListener('ended', function () { self.onAudioEnd(); });
    this._au = a;
    return a;
  }

  setDur(key, d) {
    if (!d || !isFinite(d)) return;
    var cd = Object.assign({}, this.state.cdur);
    if (Math.abs((cd[key] || 0) - d) < 1) return;
    cd[key] = d;
    this.setState({ cdur: cd });
    var all = this.cStore().dur || {};
    all[key] = Math.round(d);
    this.cSave({ dur: all });
  }

  // Mesure séquentielle des durées réelles (métadonnées seulement), mise en cache
  measureCourse(name) {
    var self = this;
    var c = this.courseOf(name);
    var todo = [];
    c.lessons.forEach(function (l, i) {
      var key = self.lKey(name, i);
      if (l.f && !self.state.cdur[key]) todo.push({ f: l.f, key: key });
    });
    if (!todo.length || this._probe) return;
    var probe = new window.Audio();
    probe.preload = 'metadata';
    this._probe = probe;
    var n = 0;
    function next() {
      if (n >= todo.length || self._probe !== probe) { self._probe = null; return; }
      var it = todo[n++];
      probe.onloadedmetadata = function () { self.setDur(it.key, probe.duration); next(); };
      probe.onerror = function () { next(); };
      probe.src = it.f;
    }
    next();
  }

  markDone(course, i, silent) {
    var key = this.lKey(course, i);
    if (this.state.listened[key]) return;
    var li = Object.assign({}, this.state.listened);
    li[key] = true;
    this.setState({ listened: li });
    var dn = this.cStore().done || {};
    dn[key] = 1;
    this.cSave({ done: dn });
    if (!silent) this.toast('Cours ' + String(i + 1).padStart(2, '0') + ' terminé');
  }

  unmarkDone(course, i) {
    var key = this.lKey(course, i);
    var li = Object.assign({}, this.state.listened);
    delete li[key];
    this.setState({ listened: li });
    var dn = this.cStore().done || {};
    delete dn[key];
    this.cSave({ done: dn });
    this.toast('Cours ' + String(i + 1).padStart(2, '0') + ' à reprendre');
  }

  savePos(course, i, pos) {
    var key = this.lKey(course, i);
    var ps = this.cStore().pos || {};
    ps[key] = Math.round(pos);
    this.cSave({ pos: ps });
  }

  onAudioMeta() {
    var p = this.state.player;
    if (!p || !p.file || !this._au) return;
    var a = this._au, d = a.duration;
    this.setDur(this.lKey(p.course, p.idx), d);
    if (this._seekTo) { try { a.currentTime = this._seekTo; } catch (e) {} this._seekTo = 0; }
    if (d && isFinite(d)) this.setState({ player: Object.assign({}, this.state.player, { dur: d }) });
  }

  onAudioTime() {
    var p = this.state.player;
    if (!p || !p.file || !this._au) return;
    var a = this._au, pos = a.currentTime || 0;
    if (this._seekPend !== null && this._seekPend !== undefined) {
      if (Math.abs(pos - this._seekPend) > 1.2) return;
      this._seekPend = null;
    }
    if (Math.floor(pos) === Math.floor(p.pos)) return;
    var dur = (a.duration && isFinite(a.duration)) ? a.duration : p.dur;
    var key = this.lKey(p.course, p.idx);
    var cp = Object.assign({}, this.state.cpos);
    cp[key] = pos;
    this.setState({ player: Object.assign({}, p, { pos: pos, dur: dur }), cpos: cp });
    var now = Date.now();
    if (!this._psave || now - this._psave > 5000) { this._psave = now; this.savePos(p.course, p.idx, pos); }
    // fin raisonnable : les dernières secondes valent achèvement
    if (dur && pos >= dur - 10) this.markDone(p.course, p.idx, true);
  }

  onAudioEnd() {
    var p = this.state.player;
