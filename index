            <div style="display:flex;align-items:center;gap:12px">
              <div style="font-family:'Fraunces',Georgia,serif;font-size:24px;font-weight:600;letter-spacing:-0.02em;font-variant-numeric:tabular-nums;flex-shrink:0;color:{{ cs.qcmInk }}">{{ cs.qcmScoreLabel }}</div>
              <div style="flex:1;min-width:0;font-size:12px;font-weight:500;color:#373329;line-height:1.5">{{ cs.qcmVerdict }}</div>
