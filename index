  nP() { return Object.assign({}, this.NPREFS, this.state.nprefs || {}); }

  nStore() { try { return JSON.parse(window.localStorage.getItem(this.NKEY)) || {}; } catch (e) { return {}; } }

  nSave(prefs, log) {
    try {
      window.localStorage.setItem(this.NKEY, JSON.stringify({
        prefs: prefs || this.state.nprefs || {},
        log: (log || this.state.notifs || []).slice(0, 60),
        sched: this._nq || [], fired: this._nFired || {}
      }));
    } catch (e) {}
  }

  prTimes() {
    var m = null;
    for (var i = 0; i < this.MOSQUES.length; i++) if (this.MOSQUES[i].id === this.state.mosque) m = this.MOSQUES[i];
    if (!m) m = this.MOSQUES[0];
    var o = {};
    m.times.forEach(function (p) { o[p.n] = p.m; });
    return o;
  }

  // Projection d'un jour du monde de démo sur le calendrier réel
  nEpoch(dayKey, min) {
    var shift = Math.round((this.pd(dayKey) - this.pd(this.TODAY_KEY)) / 86400000);
    var d = new Date(); d.setHours(0, 0, 0, 0);
    d.setDate(d.getDate() + shift);
    return d.getTime() + min * 60000;
  }

  nNext(min) {
    var d = new Date(); d.setHours(0, 0, 0, 0);
    var t = d.getTime() + min * 60000;
    if (t <= Date.now()) t += 86400000;
    return t;
  }

  nBoot() {
    var s = this.nStore();
    var prefs = Object.assign({}, this.NPREFS, s.prefs || {});
    if (typeof Notification !== 'undefined' && Notification.permission) prefs.perm = Notification.permission;
    this._nq = s.sched || [];
    this._nFired = s.fired || null;
    var first = !this._nFired;
    if (first) {
      // première ouverture : les nouveautés déjà publiées ne repartent pas en notification
      this._nFired = {};
      var f = this._nFired;
      this.NEWS.forEach(function (n) { f['news:' + n.id] = 1; });
    }
    var log = s.log || this.nSeed();
    this.setState({ nprefs: prefs, notifs: log, accent: s.accent || '', gcolors: s.gcolors || {} });
    if (s.accent) this.thApply(s.accent);
    var self = this;
    this._nInt = setInterval(function () { self.nTick(); }, 30000);
    setTimeout(function () {
      self.nDailyEnsure();
      self.nEventsEnsure();
      self.nNewsCheck();
      self.nTick();
