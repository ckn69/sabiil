            <div style="font-size:13.5px;font-weight:700;letter-spacing:-0.015em">Fiche en préparation</div>
            <div style="font-size:12px;font-weight:500;color:#8A8578;line-height:1.5;margin-top:5px">La fiche de révision de ce module sera publiée prochainement.</div>
          </div>
        </sc-if>
        <button onClick="{{ cs.exportFiche }}" style="width:100%;border:1px solid #E4E1D8;border-radius:13px;padding:12px;background:#fff;color:#4F4B40;font-size:13px;font-weight:700;margin-top:2px">Copier la fiche dans mes notes</button>
      </sc-if>

      <sc-if value="{{ cs.isQcm }}" hint-placeholder-val="{{ false }}">
        <sc-if value="{{ cs.qcmDone }}" hint-placeholder-val="{{ false }}">
