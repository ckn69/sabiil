    { n: 41, p: 89, ar: 'دُعَاءُ قَضَاءِ الدَّيْنِ', fr: "Invocation pour l'acquittement d'une dette" },
    { n: 42, p: 89, ar: 'دُعَاءُ الْوَسْوَسَةِ فِي الصَّلَاةِ وَالْقِرَاءَةِ', fr: 'Invocation contre les insinuations dans la prière' },
    { n: 43, p: 90, ar: 'دُعَاءُ مَنِ اسْتَصْعَبَ عَلَيْهِ أَمْرٌ', fr: 'Invocation de qui trouve une affaire difficile' },
    { n: 44, p: 90, ar: 'مَا يَقُولُ وَيَفْعَلُ مَنْ أَذْنَبَ ذَنْباً', fr: 'Ce que dit et fait celui qui commet un péché' },
    { n: 45, p: 91, ar: 'دُعَاءُ طَرْدِ الشَّيْطَانِ وَوَسَاوِسِهِ', fr: 'Invocation pour chasser le diable et ses insinuations' },
    { n: 46, p: 92, ar: 'الدُّعَاءُ حِينَمَا يَقَعُ مَا لَا يَرْضَاهُ أَوْ غُلِبَ عَلَى أَمْرِهِ', fr: "Invocation lorsque survient ce qu'on n'aime pas" },
    { n: 47, p: 92, ar: 'تَهْنِئَةُ الْمَوْلُودِ لَهُ وَجَوَابُهُ', fr: 'Féliciter le nouveau parent et sa réponse' },
    { n: 48, p: 93, ar: 'مَا يُعَوَّذُ بِهِ الْأَوْلَادُ', fr: 'Ce par quoi on protège les enfants' },
    { n: 49, p: 93, ar: 'الدُّعَاءُ لِلْمَرِيضِ فِي عِيَادَتِهِ', fr: 'Invocation pour le malade lors de la visite' },
    { n: 50, p: 94, ar: 'فَضْلُ عِيَادَةِ الْمَرِيضِ', fr: 'Le mérite de visiter le malade' },
    { n: 51, p: 95, ar: 'دُعَاءُ الْمَرِيضِ الَّذِي يَئِسَ مِنْ حَيَاتِهِ', fr: 'Invocation du malade qui a perdu espoir' },
    { n: 52, p: 96, ar: 'تَلْقِينُ الْمُحْتَضَرِ لَا إِلَهَ إِلَّا اللهُ', fr: 'Rappeler la shahāda au mourant' },
    { n: 53, p: 96, ar: 'دُعَاءُ مَنْ أُصِيبَ بِمُصِيبَةٍ', fr: "Invocation de celui qui est frappé d'un malheur" },
    { n: 54, p: 97, ar: 'الدُّعَاءُ عِنْدَ إِغْمَاضِ الْمَيِّتِ', fr: 'Invocation en fermant les yeux du défunt' },
    { n: 55, p: 97, ar: 'الدُّعَاءُ لِلْمَيِّتِ فِي الصَّلَاةِ عَلَيْهِ', fr: 'Invocation pour le défunt lors de la prière funéraire' },
    { n: 56, p: 100, ar: 'الدُّعَاءُ لِلْفَرَطِ فِي الصَّلَاةِ عَلَيْهِ', fr: "Invocation pour l'enfant lors de la prière funéraire" },
    { n: 57, p: 102, ar: 'دُعَاءُ التَّعْزِيَةِ', fr: 'Invocation de condoléances' },
    { n: 58, p: 102, ar: 'الدُّعَاءُ عِنْدَ إِدْخَالِ الْمَيِّتِ الْقَبْرَ', fr: 'Invocation en descendant le défunt dans la tombe' },
    { n: 59, p: 103, ar: 'الدُّعَاءُ بَعْدَ دَفْنِ الْمَيِّتِ', fr: "Invocation après l'enterrement" },
    { n: 60, p: 103, ar: 'دُعَاءُ زِيَارَةِ الْقُبُورِ', fr: 'Invocation lors de la visite des tombes' },
    { n: 61, p: 104, ar: 'دُعَاءُ الرِّيحِ', fr: 'Invocation lors du vent' },
    { n: 62, p: 105, ar: 'دُعَاءُ الرَّعْدِ', fr: 'Invocation lors du tonnerre' },
    { n: 63, p: 105, ar: 'مِنْ أَدْعِيَةِ الاسْتِسْقَاءِ', fr: 'Invocations pour demander la pluie' },
    { n: 64, p: 106, ar: 'الدُّعَاءُ إِذَا رَأَى الْمَطَرَ', fr: 'Invocation en voyant la pluie' },
    { n: 65, p: 106, ar: 'الذِّكْرُ بَعْدَ نُزُولِ الْمَطَرِ', fr: 'Dhikr après la pluie' },
    { n: 66, p: 107, ar: 'مِنْ أَدْعِيَةِ الاسْتِصْحَاءِ', fr: "Invocations pour demander l'arrêt de la pluie" },
    { n: 67, p: 107, ar: 'دُعَاءُ رُؤْيَةِ الْهِلَالِ', fr: 'Invocation en voyant le croissant' },
    { n: 68, p: 108, ar: 'الدُّعَاءُ عِنْدَ إِفْطَارِ الصَّائِمِ', fr: 'Invocation à la rupture du jeûne' },
    { n: 69, p: 108, ar: 'الدُّعَاءُ قَبْلَ الطَّعَامِ', fr: 'Invocation avant le repas' },
    { n: 70, p: 109, ar: 'الدُّعَاءُ عِنْدَ الْفَرَاغِ مِنَ الطَّعَامِ', fr: 'Invocation à la fin du repas' },
    { n: 71, p: 110, ar: 'دُعَاءُ الضَّيْفِ لِصَاحِبِ الطَّعَامِ', fr: "Invocation de l'invité pour son hôte" },
    { n: 72, p: 110, ar: 'الدُّعَاءُ إِذَا أَرَادَ الطَّعَامَ أَوِ الشَّرَابَ', fr: 'Invocation pour qui veut manger ou boire' },
    { n: 73, p: 111, ar: 'الدُّعَاءُ إِذَا أَفْطَرَ عِنْدَ أَهْلِ بَيْتٍ', fr: 'Invocation de qui rompt le jeûne chez des hôtes' },
    { n: 74, p: 111, ar: 'دُعَاءُ الصَّائِمِ إِذَا حَضَرَ الطَّعَامَ وَلَمْ يُفْطِرْ', fr: 'Invocation du jeûneur devant un repas' },
    { n: 75, p: 112, ar: 'مَا يَقُولُ الصَّائِمُ إِذَا سَابَّهُ أَحَدٌ', fr: "Ce que dit le jeûneur si on l'insulte" },
    { n: 76, p: 112, ar: 'الدُّعَاءُ عِنْدَ رُؤْيَةِ بَاكُورَةِ الثَّمَرِ', fr: 'Invocation en voyant les premiers fruits' },
    { n: 77, p: 113, ar: 'دُعَاءُ الْعُطَاسِ', fr: "Invocation de l'éternuement" },
    { n: 78, p: 113, ar: 'مَا يُقَالُ لِلْكَافِرِ إِذَا عَطَسَ فَحَمِدَ اللهَ', fr: "Ce qu'on dit au mécréant qui loue Allah en éternuant" },
    { n: 79, p: 113, ar: 'الدُّعَاءُ لِلْمُتَزَوِّجِ', fr: 'Invocation pour les nouveaux mariés' },
    { n: 80, p: 114, ar: 'دُعَاءُ الْمُتَزَوِّجِ لِنَفْسِهِ وَدُعَاءُ شِرَاءِ الدَّابَّةِ', fr: "Invocation du marié et invocation à l'achat d'une monture" },
    { n: 81, p: 115, ar: 'الدُّعَاءُ قَبْلَ إِتْيَانِ الْأَهْلِ', fr: "Invocation avant de s'unir à son épouse" },
    { n: 82, p: 115, ar: 'دُعَاءُ الْغَضَبِ', fr: 'Invocation dans la colère' },
    { n: 83, p: 115, ar: 'دُعَاءُ مَنْ رَأَى مُبْتَلًى', fr: 'Invocation en voyant une personne éprouvée' },
    { n: 84, p: 116, ar: 'مَا يُقَالُ فِي الْمَجْلِسِ', fr: "Ce qu'on dit dans une assise" },
    { n: 85, p: 116, ar: 'كَفَّارَةُ الْمَجْلِسِ', fr: "L'expiation de l'assise" },
    { n: 86, p: 117, ar: 'الدُّعَاءُ لِمَنْ قَالَ غَفَرَ اللهُ لَكَ', fr: 'Invocation pour qui dit : quʾAllah te pardonne' },
    { n: 87, p: 117, ar: 'الدُّعَاءُ لِمَنْ صَنَعَ إِلَيْكَ مَعْرُوفاً', fr: "Invocation pour qui t'a fait du bien" },
    { n: 88, p: 117, ar: 'الذِّكْرُ الَّذِي يَعْصِمُ اللهُ بِهِ مِنَ الدَّجَّالِ', fr: "Le dhikr qui protège de l'Antéchrist" },
    { n: 89, p: 118, ar: 'الدُّعَاءُ لِمَنْ قَالَ إِنِّي أُحِبُّكَ فِي اللهِ', fr: "Invocation pour qui dit : je t'aime en Allah" },
    { n: 90, p: 118, ar: 'الدُّعَاءُ لِمَنْ عَرَضَ عَلَيْكَ مَالَهُ', fr: "Invocation pour qui t'offre ses biens" },
    { n: 91, p: 118, ar: 'الدُّعَاءُ لِمَنْ أَقْرَضَ عِنْدَ الْقَضَاءِ', fr: "Invocation pour qui t'a prêté, au remboursement" },
    { n: 92, p: 119, ar: 'دُعَاءُ الْخَوْفِ مِنَ الشِّرْكِ', fr: 'Invocation contre la crainte du shirk' },
    { n: 93, p: 119, ar: 'الدُّعَاءُ لِمَنْ قَالَ بَارَكَ اللهُ فِيكَ', fr: "Invocation pour qui dit : qu'Allah te bénisse" },
    { n: 94, p: 120, ar: 'دُعَاءُ كَرَاهِيَةِ الطِّيَرَةِ', fr: 'Invocation contre la superstition' },
    { n: 95, p: 120, ar: 'دُعَاءُ رُكُوبِ الدَّابَّةِ أَوْ مَا يَقُومُ مَقَامَهَا', fr: 'Invocation en montant une monture ou un véhicule' },
    { n: 96, p: 121, ar: 'دُعَاءُ السَّفَرِ', fr: 'Invocation du voyage' },
    { n: 97, p: 122, ar: 'دُعَاءُ دُخُولِ الْقَرْيَةِ أَوِ الْبَلْدَةِ', fr: 'Invocation en entrant dans une ville' },
    { n: 98, p: 123, ar: 'دُعَاءُ دُخُولِ السُّوقِ', fr: 'Invocation en entrant au marché' },
    { n: 99, p: 124, ar: 'الدُّعَاءُ إِذَا تَعَسَ الْمَرْكُوبُ', fr: 'Invocation si la monture trébuche' },
    { n: 100, p: 124, ar: 'دُعَاءُ الْمُسَافِرِ لِلْمُقِيمِ', fr: 'Invocation du voyageur pour celui qui reste' },
    { n: 101, p: 125, ar: 'دُعَاءُ الْمُقِيمِ لِلْمُسَافِرِ', fr: 'Invocation de celui qui reste pour le voyageur' },
    { n: 102, p: 125, ar: 'التَّكْبِيرُ وَالتَّسْبِيحُ فِي سَيْرِ السَّفَرِ', fr: 'Le takbīr et le tasbīḥ en route' },
    { n: 103, p: 126, ar: 'دُعَاءُ الْمُسَافِرِ إِذَا أَسْحَرَ', fr: "Invocation du voyageur à l'aube" },
    { n: 104, p: 126, ar: 'الدُّعَاءُ إِذَا نَزَلَ مَنْزِلاً فِي سَفَرٍ أَوْ غَيْرِهِ', fr: 'Invocation en faisant halte' },
    { n: 105, p: 127, ar: 'ذِكْرُ الرُّجُوعِ مِنَ السَّفَرِ', fr: 'Dhikr du retour de voyage' },
    { n: 106, p: 127, ar: 'مَا يَقُولُ مَنْ أَتَاهُ أَمْرٌ يَسُرُّهُ أَوْ يَكْرَهُهُ', fr: "Ce que dit celui à qui survient une chose agréable ou détestable" },
    { n: 107, p: 128, ar: 'فَضْلُ الصَّلَاةِ عَلَى النَّبِيِّ ﷺ', fr: 'Le mérite de la prière sur le Prophète ﷺ' },
    { n: 108, p: 130, ar: 'إِفْشَاءُ السَّلَامِ', fr: 'Répandre le salām' },
    { n: 109, p: 131, ar: 'كَيْفَ يُرَدُّ السَّلَامُ عَلَى الْكَافِرِ إِذَا سَلَّمَ', fr: 'Comment répondre au salām du mécréant' },
    { n: 110, p: 131, ar: 'الدُّعَاءُ عِنْدَ سَمَاعِ صِيَاحِ الدِّيكِ وَنَهِيقِ الْحِمَارِ', fr: "Invocation en entendant le coq ou l'âne" },
    { n: 111, p: 132, ar: 'الدُّعَاءُ عِنْدَ سَمَاعِ نُبَاحِ الْكِلَابِ بِاللَّيْلِ', fr: 'Invocation en entendant les chiens la nuit' },
    { n: 112, p: 132, ar: 'الدُّعَاءُ لِمَنْ سَبَبْتَهُ', fr: "Invocation pour celui qu'on a insulté" },
    { n: 113, p: 133, ar: 'مَا يَقُولُ الْمُسْلِمُ إِذَا مَدَحَ الْمُسْلِمَ', fr: "Ce que dit le musulman lorsqu'il loue un musulman" },
    { n: 114, p: 133, ar: 'مَا يَقُولُ الْمُسْلِمُ إِذَا زُكِّيَ', fr: "Ce que dit le musulman lorsqu'on fait son éloge" },
    { n: 115, p: 134, ar: 'كَيْفَ يُلَبِّي الْمُحْرِمُ فِي الْحَجِّ أَوِ الْعُمْرَةِ', fr: 'Comment le pèlerin prononce la talbiya' },
    { n: 116, p: 134, ar: 'التَّكْبِيرُ إِذَا أَتَى الرُّكْنَ الْأَسْوَدَ', fr: 'Le takbīr en arrivant à la Pierre noire' },
    { n: 117, p: 135, ar: 'الدُّعَاءُ بَيْنَ الرُّكْنِ الْيَمَانِيِّ وَالْحَجَرِ الْأَسْوَدِ', fr: 'Invocation entre le coin yéménite et la Pierre noire' },
    { n: 118, p: 135, ar: 'دُعَاءُ الْوُقُوفِ عَلَى الصَّفَا وَالْمَرْوَةِ', fr: 'Invocation sur aṣ-Ṣafā et al-Marwa' },
    { n: 119, p: 137, ar: 'الدُّعَاءُ يَوْمَ عَرَفَةَ', fr: 'Invocation le jour de ʿArafa' },
