          <svg viewBox="0 0 24 24" style="width:16px;height:16px;fill:none;stroke:#98527A;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round"><path d="M20 14.5A8.5 8.5 0 019.5 4a8.5 8.5 0 1010.5 10.5z"></path></svg>
        </div>
