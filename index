  ADH_NUM = ['٠', '١', '٢', '٣', '٤', '٥', '٦', '٧', '٨', '٩'];

  arNum(n) {
    var self = this;
    return String(n).split('').map(function (c) { return self.ADH_NUM[+c] || c; }).join('');
  }

  // Texte coranique : uniquement le texte uthmānī authentique (même source que le mushaf),
  // mis en cache. Aucun verset n'est recopié dans ce fichier.
  adhSurah(sn) {
    var self = this;
    this._qsur = this._qsur || {};
    if (this._qsur[sn]) return Promise.resolve(this._qsur[sn]);
    var ck = 'sabil.quran.uth.' + sn + '.v1';
    try {
      var raw = window.localStorage.getItem(ck);
      if (raw) { var d = JSON.parse(raw); if (d && d.length) { this._qsur[sn] = d; return Promise.resolve(d); } }
    } catch (e) {}
    return fetch(this.QM_API + '/quran/verses/uthmani?chapter_number=' + sn).then(function (r) {
      if (!r.ok) throw new Error('api');
      return r.json();
    }).then(function (j) {
      var out = (j.verses || []).map(function (v) {
        return { n: parseInt(String(v.verse_key || '').split(':')[1], 10), t: (v.text_uthmani || '').trim() };
      }).filter(function (v) { return v.n && v.t; });
      if (!out.length) throw new Error('vide');
      self._qsur[sn] = out;
      try { window.localStorage.setItem(ck, JSON.stringify(out)); } catch (e) {}
      return out;
    });
  }

  adhLoadQ(key, q) {
    var self = this, cur = this.state.adhQ || {};
    if (cur[key]) return;
    var nx = Object.assign({}, cur); nx[key] = { loading: 1 };
    this.setState({ adhQ: nx });
    this.adhSurah(q.s).then(function (arr) {
      var v = arr.filter(function (x) { return x.n >= q.from && x.n <= q.to; });
      var m = Object.assign({}, self.state.adhQ);
      m[key] = v.length ? { v: v } : { err: 1 };
      self.setState({ adhQ: m });
    }).catch(function () {
      var m = Object.assign({}, self.state.adhQ); m[key] = { err: 1 };
      self.setState({ adhQ: m });
    });
  }

