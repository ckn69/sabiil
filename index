  // ── Agenda de l'appareil : vrai fichier .ics (titre, date, heures, lieu, description, alarme)
  icsFor(dk, ev) {
    var p2 = function (n) { return String(n).padStart(2, '0'); };
    var esc = function (s) {
      return String(s === undefined || s === null ? '' : s)
        .split('\\').join('\\\\').split(';').join('\\;').split(',').join('\\,').split('\n').join('\\n');
    };
    var stamp = function (key, min) {
      var a = key.split('-');
      return a[0] + a[1] + a[2] + 'T' + p2(Math.floor(min / 60) % 24) + p2(min % 60) + '00';
    };
    var end = ev.e && ev.e > ev.s ? ev.e : Math.min(1440, ev.s + 30);
    var L = ['BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//Sabil//Agenda//FR', 'CALSCALE:GREGORIAN', 'BEGIN:VEVENT'];
    L.push('UID:sabil-' + ev.id + '-' + dk + '@sabil.app');
    L.push('DTSTAMP:' + stamp(dk, 0) + 'Z');
    L.push('DTSTART:' + stamp(dk, ev.s));
    L.push('DTEND:' + stamp(dk, end));
    L.push('SUMMARY:' + esc(ev.name));
    if (ev.loc) L.push('LOCATION:' + esc(ev.loc));
    var desc = ev.desc || [ev.note || '', ev.tel ? 'Contact : ' + ev.tel : ''].filter(Boolean).join('\n');
    if (desc) L.push('DESCRIPTION:' + esc(desc));
    if (ev.rem !== null && ev.rem !== undefined && ev.rem >= 0) {
      L.push('BEGIN:VALARM', 'TRIGGER:-PT' + ev.rem + 'M', 'ACTION:DISPLAY', 'DESCRIPTION:' + esc(ev.name), 'END:VALARM');
    }
    L.push('END:VEVENT', 'END:VCALENDAR');
    return L.join('\r\n');
  }

  nToAgenda(dk, ev, silent) {
    try {
      var blob = new Blob([this.icsFor(dk, ev)], { type: 'text/calendar;charset=utf-8' });
      var url = URL.createObjectURL(blob);
      var a = document.createElement('a');
      a.href = url;
      a.download = (String(ev.name || 'activite').replace(/[^0-9A-Za-z -]/g, '').trim() || 'activite') + '.ics';
      document.body.appendChild(a); a.click(); a.remove();
      setTimeout(function () { URL.revokeObjectURL(url); }, 5000);
      if (!silent) this.toast('Activité envoyée à l\'agenda de l\'appareil');
    } catch (e) {
      this.toast('Agenda de l\'appareil indisponible');
    }
  }

  // ── Personnalisation contrôlée : un seul accent, nuances dérivées
  thHsl(hex) {
    var h = hex.replace('#', '');
    var r = parseInt(h.substr(0, 2), 16) / 255, g = parseInt(h.substr(2, 2), 16) / 255, b = parseInt(h.substr(4, 2), 16) / 255;
    var mx = Math.max(r, g, b), mn = Math.min(r, g, b), d = mx - mn;
    var H = 0, S = 0, L = (mx + mn) / 2;
    if (d) {
      S = L > 0.5 ? d / (2 - mx - mn) : d / (mx + mn);
      if (mx === r) H = ((g - b) / d) % 6;
      else if (mx === g) H = (b - r) / d + 2;
      else H = (r - g) / d + 4;
      H *= 60; if (H < 0) H += 360;
    }
    return { h: H, s: S, l: L };
  }

  thHex(h, s, l) {
    s = Math.max(0, Math.min(1, s)); l = Math.max(0, Math.min(1, l));
    var c = function (n) {
      var k = (n + h / 30) % 12;
      var a = s * Math.min(l, 1 - l);
      var v = l - a * Math.max(-1, Math.min(Math.min(k - 3, 9 - k), 1));
      return Math.round(v * 255).toString(16).padStart(2, '0');
    };
    return '#' + c(0) + c(8) + c(4);
  }

  thShades(hex) {
    var c = this.thHsl(hex);
    return {
      a: hex,
      a2: this.thHex(c.h, Math.min(1, c.s + 0.06), Math.max(0.1, c.l - 0.08)),
