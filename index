  ntStamp(ts) {
    if (!ts) return '';
    var d = new Date(ts), p = function (n) { return String(n).padStart(2, '0'); };
    return p(d.getDate()) + '/' + p(d.getMonth() + 1) + ' · ' + p(d.getHours()) + ':' + p(d.getMinutes());
  }

  ntAdd(title, body) {
    var n = { id: 'n' + Date.now(), title: (title || '').trim(), body: body || '', ts: Date.now() };
    var list = [n].concat(this.state.ntList || []);
    this.setState({ ntList: list });
    this.ntPersist(list);
    return n;
  }

  ntAll() {
    var self = this, st = this.state, out = [];
    (st.ntList || []).forEach(function (n) {
      out.push({ id: n.id, kind: 'libre', title: (n.title || '').trim() || 'Note sans titre', body: n.body || '', ts: n.ts || 0 });
    });
    Object.keys(st.cnotes || {}).forEach(function (k) {
      var t = (st.cnotes[k] || '').trim();
      if (t) out.push({ id: 'c:' + k, kind: 'cours', title: k, body: t, ts: 0, ref: k });
    });
    Object.keys(st.rdNotes || {}).forEach(function (k) {
      var t = (st.rdNotes[k] || '').trim();
      if (!t) return;
      var p = k.split(':'), sr = self.SURAHS[(+p[0]) - 1];
      out.push({ id: 'q:' + k, kind: 'coran', title: 'Sūrat ' + (sr ? sr[2] : p[0]) + ' · verset ' + p[1], body: t, ts: 0, ref: k });
    });
    (st.pdfNotes || []).forEach(function (n, i) {
      out.push({ id: 'p:' + i, kind: 'livre', title: (n.bookLabel || 'Livre') + ' · page ' + n.page, body: n.txt || '', ts: 0, ref: n.page });
    });
    return out;
  }

  ntOpenSource(it) {
    var st = this.state;
    if (it.kind === 'cours') {
      this.setState({ screen: 'learn', course: it.ref, ctab: 'notes', noteDraft: st.cnotes[it.ref] || '', ntEdit: null });
      this.measureCourse(it.ref);
    } else if (it.kind === 'coran') {
      var p = String(it.ref).split(':');
      this.setState({ screen: 'mushaf', msMode: 'ayah', rdSurah: +p[0], rdSel: +p[1], ntEdit: null });
    } else {
      this.toast('Ouvre le livre depuis Ressources pour retrouver cette page');
    }
  }

  ntVals() {
    var self = this, st = this.state;
    var all = this.ntAll(), q = (st.ntQuery || '').trim().toLowerCase(), fil = st.ntFilter || 'all';
    var counts = { all: all.length, libre: 0, cours: 0, coran: 0, livre: 0 };
    all.forEach(function (n) { counts[n.kind]++; });
    var rows = all.filter(function (n) {
      if (fil !== 'all' && n.kind !== fil) return false;
      if (!q) return true;
      return (n.title + ' ' + n.body).toLowerCase().indexOf(q) !== -1;
    });
    var ed = st.ntEdit;
    var edMeta = ed ? (self.NT_CATS[ed.kind] || self.NT_CATS.libre) : null;
    var edTint = ed ? self.tint(edMeta.cat) : null;

    var out = {
      ntListShow: !ed, ntEditShow: !!ed,
      ntQuery: st.ntQuery || '',
      ntSetQuery: function (e) { self.setState({ ntQuery: e.target.value }); },
      ntClearShow: (st.ntQuery || '') ? 'flex' : 'none',
      ntClear: function () { self.setState({ ntQuery: '' }); },
      ntCount: all.length,
      ntSub: all.length ? (all.length + ' note(s) · cours, Coran, livres et notes libres') : 'Tes notes de cours et de lecture, au même endroit',
