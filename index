              <div style="font-size:13px;font-weight:700;font-variant-numeric:tabular-nums;letter-spacing:-0.02em;color:{{ b.timeInk }}">{{ b.time }}</div>
              <div style="font-size:10px;font-weight:600;color:#B6B1A5;margin-top:1px">{{ b.dur }}</div>
            </div>
            <div style="width:1px;align-self:stretch;background:#EFEDE6;flex-shrink:0"></div>
            <div style="width:30px;height:30px;border-radius:9px;display:flex;align-items:center;justify-content:center;flex-shrink:0;background:{{ b.bg }}">
              <svg viewBox="0 0 24 24" style="width:16px;height:16px;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;stroke:{{ b.ink }}"><path d="{{ b.d }}"></path><path d="{{ b.d2 }}"></path></svg>
            </div>
            <div style="flex:1;min-width:0">
              <div style="font-size:14px;font-weight:600;letter-spacing:-0.012em;line-height:1.25;color:{{ b.nameInk }};text-decoration:{{ b.deco }}">{{ b.name }}</div>
              <div style="font-size:11px;font-weight:600;color:#A8A399;margin-top:2px">{{ b.cat }}</div>
            </div>
            <button onClick="{{ b.toggle }}" style="width:26px;height:26px;border-radius:8px;border:1.5px solid;display:flex;align-items:center;justify-content:center;flex-shrink:0;background:{{ b.checkBg }};border-color:{{ b.checkBorder }}">
              <svg viewBox="0 0 24 24" style="width:14px;height:14px;fill:none;stroke-width:3;stroke-linecap:round;stroke-linejoin:round;stroke:{{ b.checkInk }}"><path d="M5 13l4 4L19 7"></path></svg>
            </button>
          </div>
          </div>
        </sc-for>
      </div>
    </div>

    <!-- mes outils : déplacé sous le contenu du jour -->
    <sc-if value="{{ showTools }}" hint-placeholder-val="{{ true }}">
    <div style="padding:22px 20px 0">
      <div style="display:flex;align-items:baseline;justify-content:space-between;padding:0 2px 10px">
        <div style="font-size:11px;font-weight:700;letter-spacing:0.09em;text-transform:uppercase;color:#8A8578">Mes outils</div>
        <div style="font-size:11px;font-weight:600;color:#A8A399">Personnaliser →</div>
      </div>
      <div style="background:#fff;border:1px solid #E4E1D8;border-radius:13px;padding:11px 12px;margin-bottom:8px;align-items:center;gap:11px;display:{{ fastNote.show }}">
