        at: now - 30 * H, read: true, count: 1, dest: { sheet: 'news', news: 'adhkar-hisn' } }
    ];
  }

  nAllowed(type, prefKey) {
    var p = this.nP();
    if (!p.master) return false;
    var k = prefKey || (this.NTYPES[type] ? this.NTYPES[type].pref : null);
    if (k && p[k] === false) return false;
    return true;
  }

  // Émission : journal in-app (avec regroupement) + notification système
  nFire(n) {
    if (!this.nAllowed(n.type, n.pref)) return;
    var log = (this.state.notifs || []).slice();
    var now = Date.now(), gk = n.gkey || '', entry = null;
    if (gk) {
      for (var i = 0; i < log.length; i++) {
        if (log[i].gkey === gk && !log[i].read && (now - log[i].at) < 180000) {
          var c = (log[i].count || 1) + 1;
          entry = Object.assign({}, log[i], { count: c, at: now, msg: c + ' nouveaux messages' });
          log[i] = entry;
          break;
        }
      }
    }
    if (!entry) {
      entry = {
        id: 'n' + now + '-' + Math.floor(Math.random() * 1000),
        type: n.type, title: n.title, msg: n.msg, at: n.at && n.at < now ? n.at : now,
        read: false, count: 1, gkey: gk, ref: n.ref || null, dest: n.dest || null
      };
      log.unshift(entry);
    }
    log = log.slice(0, 60);
    this.setState({ notifs: log });
    this.nSave(null, log);
    this.nSystem(entry);
  }

  nSystem(n) {
    try {
      if (typeof Notification === 'undefined' || Notification.permission !== 'granted') return;
      new Notification(n.title, { body: n.msg, tag: n.gkey || n.id, silent: false });
    } catch (e) {}
  }

  nAskPerm() {
    var self = this;
    if (typeof Notification === 'undefined') { this.toast('Notifications non prises en charge ici'); return; }
    var apply = function (r, msg) {
      var np = Object.assign({}, self.nP(), { perm: r });
      self.setState({ nprefs: np });
      self.nSave(np);
      self.toast(msg);
    };
    if (Notification.permission !== 'default') {
      apply(Notification.permission, Notification.permission === 'granted'
        ? 'Notifications déjà autorisées'
        : 'Refusées · à réactiver dans les réglages du système');
      return;
    }
    Notification.requestPermission().then(function (r) {
      apply(r, r === 'granted' ? 'Notifications autorisées' : 'Notifications refusées');
    }).catch(function () {});
  }

  nQueue(e) {
    if (!this._nq) this._nq = [];
    this._nq = this._nq.filter(function (x) { return x.key !== e.key; });
    if (e.at > Date.now() - 120000) this._nq.push(e);
    this.nSave();
  }

  nDrop(key) {
    this._nq = (this._nq || []).filter(function (x) { return x.key !== key; });
    this.nSave();
  }

  nTick() {
    var now = Date.now(), due = [], keep = [], self = this;
    (this._nq || []).forEach(function (e) { (e.at <= now ? due : keep).push(e); });
    this._nq = keep;
    due.forEach(function (e) {
      if (e.type === 'goals') {
        if (!self.nGoalsLeft()) return;
        e = Object.assign({}, e, { msg: self.nGoalsMsg() });
      }
      self.nFire(e);
    });
    if (due.length) this.nDailyEnsure();
    this.nHijriCheck();
    if (due.length) this.nSave();
  }

  nGoalsLeft() {
    var o = this.state.obj || {}, left = 0;
    this.OBJ.forEach(function (x) { if (!o[x.k]) left++; });
    return left;
  }

