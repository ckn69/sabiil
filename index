          <svg viewBox="0 0 24 24" style="width:19px;height:19px;fill:#E3C063"><path d="M12 2.5l2.4 6L21 9.6l-4.8 4.2 1.3 6.9L12 17.4l-5.5 3.3 1.3-6.9L3 9.6l6.6-1.1z"></path></svg>
