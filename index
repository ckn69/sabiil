          else if (t.k === 'objectifs') self.setState({ screen: 'objectifs' });
          else self.toast(t.label + ' — module porté à la prochaine étape');
        }
      };
    });

    // ── agenda : grille ──
    var hours = [];
    for (var h = 0; h <= 23; h++) hours.push({ label: String(h).padStart(2, '0') + 'h', top: this.px(h * 60) });

    var SB = {
      group:   { bg: 'var(--sb-abg)', border: 'var(--sb-abd)', ink: 'var(--sb-ai)', status: 'En groupe' },
      alone:   { bg: '#F7EFDD', border: '#EADFC4', ink: '#8A5E1F', status: 'Seul' },
      missed:  { bg: '#F7E4DE', border: '#EDCEC5', ink: '#A33D25', status: 'Manquée' },
      current: { bg: 'var(--sb-abg)', border: 'var(--sb-a)', ink: 'var(--sb-ai)', status: 'En cours' },
      pending: { bg: '#F1F0EA', border: '#E4E1D8', ink: '#6B6759', status: 'Réservé' }
    };
    var prayerBands = PR.map(function (p) {
      var s = SB[st.ps[p.n]] || SB.pending;
      var a = Math.max(0, p.m - self.bufBefore(p.n)), b = Math.min(1440, p.m + self.bufAfter(p.n));
      var bf = self.bufOf(p.n), all = [], tcur = a;
      self.PHASE_MIX.forEach(function (ph) {
