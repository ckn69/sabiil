  // ═══════════════════════════════════════════════════════════
  HIJRI_MONTHS_FR = ['Muḥarram', 'Ṣafar', 'Rabīʿ al-awwal', 'Rabīʿ ath-thānī', 'Jumādā al-ūlā', 'Jumādā ath-thāniya', 'Rajab', 'Shaʿbān', 'Ramaḍān', 'Shawwāl', 'Dhūl-Qaʿda', 'Dhūl-Ḥijja'];

