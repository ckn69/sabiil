            <div style="font-size:10px;font-weight:700;letter-spacing:0.09em;text-transform:uppercase;color:{{ b.prInk }}">{{ b.prName }}</div>
            <div style="flex:1"></div>
            <div style="font-size:10.5px;font-weight:600;color:#A8A399">{{ b.prCount }}</div>
