    { n: 24, p: 41, ar: 'الدُّعَاءُ بَعْدَ التَّشَهُّدِ الْأَخِيرِ قَبْلَ السَّلَامِ', fr: 'Invocation après le dernier tashahhud', it: [
      { n: 55, ar: '«اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنْ عَذَابِ الْقَبْرِ، وَمِنْ عَذَابِ جَهَنَّمَ، وَمِنْ فِتْنَةِ الْمَحْيَا وَالْمَمَاتِ، وَمِنْ شَرِّ فِتْنَةِ الْمَسِيحِ الدَّجَّالِ»', src: 'البخاري ٢/١٠٢ ومسلم ١/٤١٢.', p: 41 },
      { n: 56, ar: '«اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنْ عَذَابِ الْقَبْرِ، وَأَعُوذُ بِكَ مِنْ فِتْنَةِ الْمَسِيحِ الدَّجَّالِ، وَأَعُوذُ بِكَ مِنْ فِتْنَةِ الْمَحْيَا وَالْمَمَاتِ، اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنَ الْمَأْثَمِ وَالْمَغْرَمِ»', src: 'البخاري ١/٢٠٢ ومسلم ١/٤١٢.', p: 41 },
      { n: 57, ar: '«اللَّهُمَّ إِنِّي ظَلَمْتُ نَفْسِي ظُلْماً كَثِيراً، وَلَا يَغْفِرُ الذُّنُوبَ إِلَّا أَنْتَ، فَاغْفِرْ لِي مَغْفِرَةً مِنْ عِنْدِكَ، وَارْحَمْنِي، إِنَّكَ أَنْتَ الْغَفُورُ الرَّحِيمُ»', src: 'البخاري ٨/١٦٨ ومسلم ٤/٢٠٧٨.', p: 42 },
      { n: 58, ar: '«اللَّهُمَّ اغْفِرْ لِي مَا قَدَّمْتُ وَمَا أَخَّرْتُ، وَمَا أَسْرَرْتُ وَمَا أَعْلَنْتُ، وَمَا أَسْرَفْتُ، وَمَا أَنْتَ أَعْلَمُ بِهِ مِنِّي، أَنْتَ الْمُقَدِّمُ وَأَنْتَ الْمُؤَخِّرُ، لَا إِلَهَ إِلَّا أَنْتَ»', src: 'مسلم ١/٥٣٤.', p: 42 },
      { n: 59, ar: '«اللَّهُمَّ أَعِنِّي عَلَىٰ ذِكْرِكَ، وَشُكْرِكَ، وَحُسْنِ عِبَادَتِكَ»', src: 'أحمد ٥/٢٤٥ والنسائي ٣/٥٣، وانظر صحيح أبي داود ١/٢٨٤.', p: 43 },
      { n: 60, ar: '«اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنَ الْبُخْلِ، وَأَعُوذُ بِكَ مِنَ الْجُبْنِ، وَأَعُوذُ بِكَ مِنْ أَنْ أُرَدَّ إِلَىٰ أَرْذَلِ الْعُمُرِ، وَأَعُوذُ بِكَ مِنْ فِتْنَةِ الدُّنْيَا، وَأَعُوذُ بِكَ مِنْ عَذَابِ الْقَبْرِ»', src: 'النسائي ٣/٧٣ وانظر صحيح النسائي ١/٣٥٣.', p: 43 },
      { n: 61, ar: '«اللَّهُمَّ إِنِّي أَسْأَلُكَ الْجَنَّةَ وَأَعُوذُ بِكَ مِنَ النَّارِ»', src: 'أبو داود ٢/٧٩، وانظر صحيح ابن ماجه ٢/٣٢٨.', p: 44 },
      { n: 62, ar: '«اللَّهُمَّ بِعِلْمِكَ الْغَيْبَ وَقُدْرَتِكَ عَلَى الْخَلْقِ أَحْيِنِي مَا عَلِمْتَ الْحَيَاةَ خَيْراً لِي، وَتَوَفَّنِي إِذَا عَلِمْتَ الْوَفَاةَ خَيْراً لِي، اللَّهُمَّ إِنِّي أَسْأَلُكَ خَشْيَتَكَ فِي الْغَيْبِ وَالشَّهَادَةِ، وَأَسْأَلُكَ كَلِمَةَ الْحَقِّ فِي الرِّضَا وَالْغَضَبِ، وَأَسْأَلُكَ الْقَصْدَ فِي الْغِنَىٰ وَالْفَقْرِ»', src: 'النسائي ٣/٥٤ وأحمد ٤/٢٦٤، وصححه الألباني في صحيح النسائي ١/٢٨١.', p: 44 },
      { n: 63, ar: '«اللَّهُمَّ إِنِّي أَسْأَلُكَ يَا اللهُ بِأَنَّكَ الْوَاحِدُ الْأَحَدُ الصَّمَدُ الَّذِي لَمْ يَلِدْ وَلَمْ يُولَدْ وَلَمْ يَكُنْ لَهُ كُفُواً أَحَدٌ، أَنْ تَغْفِرَ لِي ذُنُوبِي، إِنَّكَ أَنْتَ الْغَفُورُ الرَّحِيمُ»', src: 'النسائي ٣/٥٢ وأحمد ٤/٣٣٨، وانظر صحيح النسائي ١/٢٧٩.', p: 45 }
    ] },
    { n: 25, p: 46, ar: 'الْأَذْكَارُ بَعْدَ السَّلَامِ مِنَ الصَّلَاةِ', fr: 'Adhkār après le salām de la prière', it: [
      { n: 64, ar: '«أَسْتَغْفِرُ اللهَ» (ثَلَاثاً) «اللَّهُمَّ أَنْتَ السَّلَامُ وَمِنْكَ السَّلَامُ، تَبَارَكْتَ يَا ذَا الْجَلَالِ وَالْإِكْرَامِ»', src: 'مسلم ١/٤١٤.', p: 46 },
      { n: 65, ar: '«لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ، لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ وَهُوَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ، اللَّهُمَّ لَا مَانِعَ لِمَا أَعْطَيْتَ، وَلَا مُعْطِيَ لِمَا مَنَعْتَ، وَلَا يَنْفَعُ ذَا الْجَدِّ مِنْكَ الْجَدُّ»', src: 'البخاري ١/٢٥٥ ومسلم ١/٤١٤.', p: 46 },
      { n: 66, ar: '«لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ، لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ وَهُوَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ، لَا حَوْلَ وَلَا قُوَّةَ إِلَّا بِاللهِ، لَا إِلَهَ إِلَّا اللهُ، وَلَا نَعْبُدُ إِلَّا إِيَّاهُ، لَهُ النِّعْمَةُ وَلَهُ الْفَضْلُ وَلَهُ الثَّنَاءُ الْحَسَنُ، لَا إِلَهَ إِلَّا اللهُ مُخْلِصِينَ لَهُ الدِّينَ وَلَوْ كَرِهَ الْكَافِرُونَ»', src: 'مسلم ١/٤١٥.', p: 47 },
      { n: 67, ar: '«سُبْحَانَ اللهِ» (ثَلَاثاً وَثَلَاثِينَ) «الْحَمْدُ لِلَّهِ» (ثَلَاثاً وَثَلَاثِينَ) «اللهُ أَكْبَرُ» (ثَلَاثاً وَثَلَاثِينَ) ثُمَّ «لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ، لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ وَهُوَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ»', note: 'مَنْ قَالَ ذَلِكَ غُفِرَتْ خَطَايَاهُ وَإِنْ كَانَتْ مِثْلَ زَبَدِ الْبَحْرِ.', src: 'مسلم ١/٤١٨.', p: 48 },
      { n: 68, q: { s: 2, from: 255, to: 255, ar: 'سورة البقرة · آية الكرسي ٢٥٥', fr: 'Sourate al-Baqara · verset du Trône (255)' }, note: 'يَقْرَأُهَا بَعْدَ كُلِّ صَلَاةٍ.', src: 'النسائي في عمل اليوم والليلة برقم ١٠٠، وصححه الألباني في صحيح الجامع ٥/٣٣٩.', p: 49 },
      { n: 69, q: { s: 112, from: 1, to: 4, ar: 'سورة الإخلاص', fr: 'Sourate al-Ikhlāṣ' }, note: 'يَقْرَأُ الْمُعَوِّذَاتِ — الْإِخْلَاصَ وَالْفَلَقَ وَالنَّاسَ — بَعْدَ كُلِّ صَلَاةٍ، وَبَعْدَ صَلَاةِ الْمَغْرِبِ وَالْفَجْرِ ثَلَاثَ مَرَّاتٍ.', src: 'أبو داود ٢/٨٦ والنسائي ٣/٦٨، وانظر صحيح الترمذي ٣/١٥٨.', p: 50 },
      { n: 70, ar: '«اللَّهُمَّ أَعِنِّي عَلَىٰ ذِكْرِكَ، وَشُكْرِكَ، وَحُسْنِ عِبَادَتِكَ»', note: 'يَقُولُهَا بَعْدَ كُلِّ صَلَاةٍ، آخِذاً بِيَدِ صَاحِبِهِ.', src: 'أبو داود ٢/٨٦ والنسائي ٣/٥٣، وانظر صحيح أبي داود ١/٢٨٤.', p: 50 },
      { n: 71, ar: '«اللَّهُمَّ إِنِّي أَسْأَلُكَ عِلْماً نَافِعاً، وَرِزْقاً طَيِّباً، وَعَمَلاً مُتَقَبَّلاً»', note: 'يَقُولُهَا بَعْدَ السَّلَامِ مِنْ صَلَاةِ الْفَجْرِ.', src: 'ابن ماجه ١/١٥٢ وانظر صحيح ابن ماجه ١/١٥٢.', p: 51 },
      { n: 72, ar: '«لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ، لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ وَهُوَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ» (عَشْرَ مَرَّاتٍ بَعْدَ الْمَغْرِبِ وَالصُّبْحِ)', src: 'الترمذي ٥/٥١٥ وأحمد ٤/٢٢٧، وانظر صحيح الترمذي ٣/١٤٥.', p: 51 }
    ] },
    { n: 26, p: 52, ar: 'دُعَاءُ صَلَاةِ الاسْتِخَارَةِ', fr: 'Invocation de la prière de consultation', it: [
      { n: 73, ar: 'عَنْ جَابِرٍ رَضِيَ اللهُ عَنْهُ قَالَ: كَانَ رَسُولُ اللهِ ﷺ يُعَلِّمُنَا الاسْتِخَارَةَ فِي الْأُمُورِ كُلِّهَا: «إِذَا هَمَّ أَحَدُكُمْ بِالْأَمْرِ فَلْيَرْكَعْ رَكْعَتَيْنِ مِنْ غَيْرِ الْفَرِيضَةِ ثُمَّ لِيَقُلْ: اللَّهُمَّ إِنِّي أَسْتَخِيرُكَ بِعِلْمِكَ، وَأَسْتَقْدِرُكَ بِقُدْرَتِكَ، وَأَسْأَلُكَ مِنْ فَضْلِكَ الْعَظِيمِ، فَإِنَّكَ تَقْدِرُ وَلَا أَقْدِرُ، وَتَعْلَمُ وَلَا أَعْلَمُ، وَأَنْتَ عَلَّامُ الْغُيُوبِ، اللَّهُمَّ إِنْ كُنْتَ تَعْلَمُ أَنَّ هَذَا الْأَمْرَ — وَيُسَمِّي حَاجَتَهُ — خَيْرٌ لِي فِي دِينِي وَمَعَاشِي وَعَاقِبَةِ أَمْرِي فَاقْدُرْهُ لِي وَيَسِّرْهُ لِي ثُمَّ بَارِكْ لِي فِيهِ، وَإِنْ كُنْتَ تَعْلَمُ أَنَّ هَذَا الْأَمْرَ شَرٌّ لِي فِي دِينِي وَمَعَاشِي وَعَاقِبَةِ أَمْرِي فَاصْرِفْهُ عَنِّي وَاصْرِفْنِي عَنْهُ، وَاقْدُرْ لِيَ الْخَيْرَ حَيْثُ كَانَ ثُمَّ أَرْضِنِي بِهِ»', src: 'البخاري مع الفتح ١١/١٨٣.', p: 52 }
    ] },
    { n: 27, p: 54, ar: 'أَذْكَارُ الصَّبَاحِ وَالْمَسَاءِ', fr: 'Adhkār du matin et du soir', it: [
      { n: 75, ar: '«أَعُوذُ بِاللهِ مِنَ الشَّيْطَانِ الرَّجِيمِ»', q: { s: 2, from: 255, to: 255, ar: 'سورة البقرة · آية الكرسي ٢٥٥', fr: 'Sourate al-Baqara · verset du Trône (255)' }, note: 'مَنْ قَالَهَا حِينَ يُصْبِحُ أُجِيرَ مِنَ الْجِنِّ حَتَّىٰ يُمْسِيَ، وَمَنْ قَالَهَا حِينَ يُمْسِي أُجِيرَ مِنْهُمْ حَتَّىٰ يُصْبِحَ.', src: 'أخرجه الحاكم ١/٥٦٢ وصححه الألباني في صحيح الترغيب والترهيب ١/٢٧٣، وعزاه إلى النسائي والطبراني وقال: إسناد الطبراني جيد.', p: 55 },
      { n: 76, q: { s: 112, from: 1, to: 4, ar: 'سورة الإخلاص', fr: 'Sourate al-Ikhlāṣ' }, note: 'يَقْرَأُ الْإِخْلَاصَ وَالْفَلَقَ وَالنَّاسَ (ثَلَاثَ مَرَّاتٍ). مَنْ قَالَهَا ثَلَاثَ مَرَّاتٍ حِينَ يُصْبِحُ وَحِينَ يُمْسِي كَفَتْهُ مِنْ كُلِّ شَيْءٍ.', src: 'أبو داود ٤/٣٢٢ والترمذي ٥/٥٦٧ وانظر صحيح الترمذي ٣/١٨٢.', p: 55 },
      { n: 77, ar: '«أَصْبَحْنَا وَأَصْبَحَ الْمُلْكُ لِلَّهِ وَالْحَمْدُ لِلَّهِ، لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ، لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ وَهُوَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ، رَبِّ أَسْأَلُكَ خَيْرَ مَا فِي هَذَا الْيَوْمِ وَخَيْرَ مَا بَعْدَهُ، وَأَعُوذُ بِكَ مِنْ شَرِّ مَا فِي هَذَا الْيَوْمِ وَشَرِّ مَا بَعْدَهُ، رَبِّ أَعُوذُ بِكَ مِنَ الْكَسَلِ، وَسُوءِ الْكِبَرِ، رَبِّ أَعُوذُ بِكَ مِنْ عَذَابٍ فِي النَّارِ وَعَذَابٍ فِي الْقَبْرِ»', note: 'وَإِذَا أَمْسَىٰ قَالَ: «أَمْسَيْنَا وَأَمْسَى الْمُلْكُ لِلَّهِ» — «رَبِّ أَسْأَلُكَ خَيْرَ مَا فِي هَذِهِ اللَّيْلَةِ وَخَيْرَ مَا بَعْدَهَا، وَأَعُوذُ بِكَ مِنْ شَرِّ مَا فِي هَذِهِ اللَّيْلَةِ وَشَرِّ مَا بَعْدَهَا».', src: 'مسلم ٤/٢٠٨٨.', p: 57 },
      { n: 78, ar: '«اللَّهُمَّ بِكَ أَصْبَحْنَا، وَبِكَ أَمْسَيْنَا، وَبِكَ نَحْيَا، وَبِكَ نَمُوتُ وَإِلَيْكَ النُّشُورُ»', note: 'وَإِذَا أَمْسَىٰ قَالَ: «اللَّهُمَّ بِكَ أَمْسَيْنَا وَبِكَ أَصْبَحْنَا وَبِكَ نَحْيَا وَبِكَ نَمُوتُ وَإِلَيْكَ الْمَصِيرُ».', src: 'الترمذي ٥/٤٦٦ وانظر صحيح الترمذي ٣/١٤٢.', p: 58 },
      { n: 79, ar: '«اللَّهُمَّ أَنْتَ رَبِّي لَا إِلَهَ إِلَّا أَنْتَ، خَلَقْتَنِي وَأَنَا عَبْدُكَ، وَأَنَا عَلَىٰ عَهْدِكَ وَوَعْدِكَ مَا اسْتَطَعْتُ، أَعُوذُ بِكَ مِنْ شَرِّ مَا صَنَعْتُ، أَبُوءُ لَكَ بِنِعْمَتِكَ عَلَيَّ، وَأَبُوءُ بِذَنْبِي فَاغْفِرْ لِي فَإِنَّهُ لَا يَغْفِرُ الذُّنُوبَ إِلَّا أَنْتَ»', note: 'سَيِّدُ الاسْتِغْفَارِ. «أَبُوءُ»: أُقِرُّ وَأَعْتَرِفُ. مَنْ قَالَهَا مُوقِناً بِهَا حِينَ يُمْسِي فَمَاتَ مِنْ لَيْلَتِهِ دَخَلَ الْجَنَّةَ، وَكَذَلِكَ إِذَا أَصْبَحَ.', src: 'أخرجه البخاري ٧/١٥٠.', p: 58 },
      { n: 80, ar: '«اللَّهُمَّ إِنِّي أَصْبَحْتُ أُشْهِدُكَ وَأُشْهِدُ حَمَلَةَ عَرْشِكَ، وَمَلَائِكَتَكَ وَجَمِيعَ خَلْقِكَ، أَنَّكَ أَنْتَ اللهُ لَا إِلَهَ إِلَّا أَنْتَ وَحْدَكَ لَا شَرِيكَ لَكَ، وَأَنَّ مُحَمَّداً عَبْدُكَ وَرَسُولُكَ» (أَرْبَعَ مَرَّاتٍ)', note: 'وَإِذَا أَمْسَىٰ قَالَ: «اللَّهُمَّ إِنِّي أَمْسَيْتُ..». مَنْ قَالَهَا حِينَ يُصْبِحُ أَوْ يُمْسِي أَرْبَعَ مَرَّاتٍ أَعْتَقَهُ اللهُ مِنَ النَّارِ.', src: 'أخرجه أبو داود ٤/٣١٧ والبخاري في الأدب المفرد برقم ١٢٠١ والنسائي في عمل اليوم والليلة برقم ٩، وابن السني برقم ٧٠، وحسن سماحة الشيخ ابن باز إسناد النسائي وأبي داود في تحفة الأخبار ص ٢٣.', p: 59 },
      { n: 81, ar: '«اللَّهُمَّ مَا أَصْبَحَ بِي مِنْ نِعْمَةٍ أَوْ بِأَحَدٍ مِنْ خَلْقِكَ فَمِنْكَ وَحْدَكَ لَا شَرِيكَ لَكَ، فَلَكَ الْحَمْدُ وَلَكَ الشُّكْرُ»', note: 'وَإِذَا أَمْسَىٰ قَالَ: «اللَّهُمَّ مَا أَمْسَىٰ بِي..». مَنْ قَالَهَا حِينَ يُصْبِحُ فَقَدْ أَدَّىٰ شُكْرَ يَوْمِهِ، وَمَنْ قَالَهَا حِينَ يُمْسِي فَقَدْ أَدَّىٰ شُكْرَ لَيْلَتِهِ.', src: 'أخرجه أبو داود ٤/٣١٨، والنسائي في عمل اليوم والليلة برقم ٧ وابن السني برقم ٤١ وابن حبان (موارد) رقم ٢٣٦١، وحسن ابن باز إسناده في تحفة الأخبار ص ٢٤.', p: 60 },
      { n: 82, ar: '«اللَّهُمَّ عَافِنِي فِي بَدَنِي، اللَّهُمَّ عَافِنِي فِي سَمْعِي، اللَّهُمَّ عَافِنِي فِي بَصَرِي، لَا إِلَهَ إِلَّا أَنْتَ. اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنَ الْكُفْرِ، وَالْفَقْرِ، وَأَعُوذُ بِكَ مِنْ عَذَابِ الْقَبْرِ، لَا إِلَهَ إِلَّا أَنْتَ» (ثَلَاثَ مَرَّاتٍ)', src: 'أبو داود ٤/٣٢٤، وأحمد ٥/٤٢، والنسائي في عمل اليوم والليلة برقم ٢٢ وابن السني برقم ٦٩ والبخاري في الأدب المفرد، وحسن العلامة ابن باز إسناده في تحفة الأخبار ص ٢٦.', p: 60 },
      { n: 83, ar: '«حَسْبِيَ اللهُ لَا إِلَهَ إِلَّا هُوَ عَلَيْهِ تَوَكَّلْتُ وَهُوَ رَبُّ الْعَرْشِ الْعَظِيمِ» (سَبْعَ مَرَّاتٍ)', note: 'مَنْ قَالَهَا حِينَ يُصْبِحُ وَحِينَ يُمْسِي سَبْعَ مَرَّاتٍ كَفَاهُ اللهُ مَا أَهَمَّهُ مِنْ أَمْرِ الدُّنْيَا وَالْآخِرَةِ.', src: 'أخرجه ابن السني برقم ٧١ مرفوعاً وأبو داود ٤/٣٢١ موقوفاً، وصحح إسناده شعيب وعبدالقادر الأرناؤوط. انظر: زاد المعاد ٢/٣٧٦.', p: 61 },
      { n: 84, ar: '«اللَّهُمَّ إِنِّي أَسْأَلُكَ الْعَفْوَ وَالْعَافِيَةَ فِي الدُّنْيَا وَالْآخِرَةِ، اللَّهُمَّ إِنِّي أَسْأَلُكَ الْعَفْوَ وَالْعَافِيَةَ: فِي دِينِي وَدُنْيَايَ وَأَهْلِي، وَمَالِي، اللَّهُمَّ اسْتُرْ عَوْرَاتِي، وَآمِنْ رَوْعَاتِي، اللَّهُمَّ احْفَظْنِي مِنْ بَيْنِ يَدَيَّ، وَمِنْ خَلْفِي، وَعَنْ يَمِينِي، وَعَنْ شِمَالِي، وَمِنْ فَوْقِي، وَأَعُوذُ بِعَظَمَتِكَ أَنْ أُغْتَالَ مِنْ تَحْتِي»', src: 'أبو داود وابن ماجه، وانظر صحيح ابن ماجه ٢/٣٣٢.', p: 61 },
      { n: 85, ar: '«اللَّهُمَّ عَالِمَ الْغَيْبِ وَالشَّهَادَةِ فَاطِرَ السَّمَاوَاتِ وَالْأَرْضِ، رَبَّ كُلِّ شَيْءٍ وَمَلِيكَهُ، أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا أَنْتَ، أَعُوذُ بِكَ مِنْ شَرِّ نَفْسِي، وَمِنْ شَرِّ الشَّيْطَانِ وَشِرَكِهِ، وَأَنْ أَقْتَرِفَ عَلَىٰ نَفْسِي سُوءاً، أَوْ أَجُرَّهُ إِلَىٰ مُسْلِمٍ»', src: 'الترمذي وأبو داود. وانظر: صحيح الترمذي ٣/١٤٢.', p: 62 },
      { n: 86, ar: '«بِسْمِ اللهِ الَّذِي لَا يَضُرُّ مَعَ اسْمِهِ شَيْءٌ فِي الْأَرْضِ وَلَا فِي السَّمَاءِ وَهُوَ السَّمِيعُ الْعَلِيمُ» (ثَلَاثَ مَرَّاتٍ)', note: 'مَنْ قَالَهَا ثَلَاثاً إِذَا أَصْبَحَ وَثَلَاثاً إِذَا أَمْسَىٰ لَمْ يَضُرَّهُ شَيْءٌ.', src: 'أخرجه أبو داود ٤/٣٢٣ والترمذي ٥/٤٦٥ وابن ماجه وأحمد. انظر: صحيح ابن ماجه ٢/٣٣٢، وحسن إسناده العلامة ابن باز في تحفة الأخبار ص ٣٩.', p: 63 },
      { n: 87, ar: '«رَضِيتُ بِاللهِ رَبّاً، وَبِالْإِسْلَامِ دِيناً، وَبِمُحَمَّدٍ ﷺ نَبِيّاً» (ثَلَاثَ مَرَّاتٍ)', note: 'مَنْ قَالَهَا ثَلَاثاً حِينَ يُصْبِحُ وَثَلَاثاً حِينَ يُمْسِي كَانَ حَقّاً عَلَى اللهِ أَنْ يُرْضِيَهُ يَوْمَ الْقِيَامَةِ.', src: 'أحمد ٤/٣٣٧ والنسائي في عمل اليوم والليلة برقم ٤ وابن السني برقم ٦٨ وأبو داود ٤/٣١٨ والترمذي ٥/٤٦٥، وحسنه ابن باز في تحفة الأخبار ص ٣٩.', p: 63 },
      { n: 88, ar: '«يَا حَيُّ يَا قَيُّومُ بِرَحْمَتِكَ أَسْتَغِيثُ أَصْلِحْ لِي شَأْنِي كُلَّهُ وَلَا تَكِلْنِي إِلَىٰ نَفْسِي طَرْفَةَ عَيْنٍ»', src: 'الحاكم وصححه ووافقه الذهبي ١/٥٤٥، وانظر صحيح الترغيب والترهيب ١/٢٧٣.', p: 64 },
      { n: 89, ar: '«أَصْبَحْنَا وَأَصْبَحَ الْمُلْكُ لِلَّهِ رَبِّ الْعَالَمِينَ، اللَّهُمَّ إِنِّي أَسْأَلُكَ خَيْرَ هَذَا الْيَوْمِ: فَتْحَهُ، وَنَصْرَهُ وَنُورَهُ، وَبَرَكَتَهُ، وَهُدَاهُ، وَأَعُوذُ بِكَ مِنْ شَرِّ مَا فِيهِ وَشَرِّ مَا بَعْدَهُ»', note: 'وَإِذَا أَمْسَىٰ قَالَ: «أَمْسَيْنَا وَأَمْسَى الْمُلْكُ لِلَّهِ رَبِّ الْعَالَمِينَ» — «اللَّهُمَّ إِنِّي أَسْأَلُكَ خَيْرَ هَذِهِ اللَّيْلَةِ: فَتْحَهَا وَنَصْرَهَا وَنُورَهَا وَبَرَكَتَهَا وَهُدَاهَا، وَأَعُوذُ بِكَ مِنْ شَرِّ مَا فِيهَا وَشَرِّ مَا بَعْدَهَا».', src: 'أبو داود ٤/٣٢٢، وحسن إسناده شعيب وعبدالقادر الأرناؤوط في تحقيق زاد المعاد ٢/٣٧٣.', p: 64 },
      { n: 90, ar: '«أَصْبَحْنَا عَلَىٰ فِطْرَةِ الْإِسْلَامِ وَعَلَىٰ كَلِمَةِ الْإِخْلَاصِ، وَعَلَىٰ دِينِ نَبِيِّنَا مُحَمَّدٍ ﷺ، وَعَلَىٰ مِلَّةِ أَبِينَا إِبْرَاهِيمَ، حَنِيفاً مُسْلِماً وَمَا كَانَ مِنَ الْمُشْرِكِينَ»', note: 'وَإِذَا أَمْسَىٰ قَالَ: «أَمْسَيْنَا عَلَىٰ فِطْرَةِ الْإِسْلَامِ..».', src: 'أحمد ٣/٤٠٦ و ٤٠٧ وابن السني في عمل اليوم والليلة برقم ٣٤، وانظر: صحيح الجامع ٤/٢٠٩.', p: 65 },
      { n: 91, ar: '«سُبْحَانَ اللهِ وَبِحَمْدِهِ» (مِائَةَ مَرَّةٍ)', note: 'مَنْ قَالَهَا مِائَةَ مَرَّةٍ حِينَ يُصْبِحُ وَحِينَ يُمْسِي لَمْ يَأْتِ أَحَدٌ يَوْمَ الْقِيَامَةِ بِأَفْضَلَ مِمَّا جَاءَ بِهِ إِلَّا أَحَدٌ قَالَ مِثْلَ مَا قَالَ أَوْ زَادَ عَلَيْهِ.', src: 'مسلم ٤/٢٠٧١.', p: 65 },
      { n: 92, ar: '«لَا إِلَهَ إِلَّا اللهُ وَحْدَهُ لَا شَرِيكَ لَهُ، لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ، وَهُوَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ» (عَشْرَ مَرَّاتٍ) أَوْ (مَرَّةً وَاحِدَةً عِنْدَ الْكَسَلِ)', src: 'النسائي في عمل اليوم والليلة برقم ٢٤، وانظر: صحيح الترغيب والترهيب ١/٢٧٢، وتحفة الأخبار لابن باز ص ٤٤ — ورواية المرة الواحدة: أبو داود ٤/٣١٩ وابن ماجه وأحمد ٤/٦٠، وانظر: صحيح أبي داود ٣/٩٥٧ وصحيح ابن ماجه ٢/٣٣١ وزاد المعاد ٢/٣٧٧.', p: 66 },
      { n: 93, ar: '«لَا إِلَهَ إِلَّا اللهُ، وَحْدَهُ لَا شَرِيكَ لَهُ، لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ وَهُوَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ» (مِائَةَ مَرَّةٍ إِذَا أَصْبَحَ)', note: 'مَنْ قَالَهَا مِائَةَ مَرَّةٍ فِي يَوْمٍ كَانَتْ لَهُ عَدْلَ عَشْرِ رِقَابٍ، وَكُتِبَ لَهُ مِائَةُ حَسَنَةٍ، وَمُحِيَتْ عَنْهُ مِائَةُ سَيِّئَةٍ، وَكَانَتْ لَهُ حِرْزاً مِنَ الشَّيْطَانِ يَوْمَهُ ذَلِكَ حَتَّىٰ يُمْسِيَ.', src: 'البخاري ٤/٩٥، ومسلم ٤/٢٠٧١.', p: 66 },
      { n: 94, ar: '«سُبْحَانَ اللهِ وَبِحَمْدِهِ: عَدَدَ خَلْقِهِ، وَرِضَا نَفْسِهِ، وَزِنَةَ عَرْشِهِ، وَمِدَادَ كَلِمَاتِهِ» (ثَلَاثَ مَرَّاتٍ إِذَا أَصْبَحَ)', src: 'مسلم ٤/٢٠٩٠.', p: 67 },
      { n: 95, ar: '«اللَّهُمَّ إِنِّي أَسْأَلُكَ عِلْماً نَافِعاً، وَرِزْقاً طَيِّباً، وَعَمَلاً مُتَقَبَّلاً» (إِذَا أَصْبَحَ)', src: 'أخرجه ابن السني في عمل اليوم والليلة برقم ٥٤ وابن ماجه برقم ٩٢٥، وحسن إسناده عبدالقادر وشعيب الأرناؤوط في تحقيق زاد المعاد ٢/٣٧٥، وتقدم ص ٥١.', p: 67 },
      { n: 96, ar: '«أَسْتَغْفِرُ اللهَ وَأَتُوبُ إِلَيْهِ» (مِائَةَ مَرَّةٍ فِي الْيَوْمِ)', src: 'البخاري مع الفتح ١١/١٠١، ومسلم ٤/٢٠٧٥.', p: 67 },
      { n: 97, ar: '«أَعُوذُ بِكَلِمَاتِ اللهِ التَّامَّاتِ مِنْ شَرِّ مَا خَلَقَ» (ثَلَاثَ مَرَّاتٍ إِذَا أَمْسَىٰ)', note: 'مَنْ قَالَهَا حِينَ يُمْسِي ثَلَاثَ مَرَّاتٍ لَمْ تَضُرَّهُ حُمَةُ تِلْكَ اللَّيْلَةِ.', src: 'أخرجه أحمد ٢/٢٩٠، والنسائي في عمل اليوم والليلة برقم ٥٩٠ وابن السني برقم ٦٨، وانظر: صحيح الترمذي ٣/١٨٧ وصحيح ابن ماجه ٢/٢٦٦ وتحفة الأخبار ص ٤٥.', p: 68 },
      { n: 98, ar: '«اللَّهُمَّ صَلِّ وَسَلِّمْ عَلَىٰ نَبِيِّنَا مُحَمَّدٍ» (عَشْرَ مَرَّاتٍ)', note: '«مَنْ صَلَّىٰ عَلَيَّ حِينَ يُصْبِحُ عَشْراً وَحِينَ يُمْسِي عَشْراً أَدْرَكَتْهُ شَفَاعَتِي يَوْمَ الْقِيَامَةِ».', src: 'أخرجه الطبراني بإسنادين أحدهما جيد، انظر: مجمع الزوائد ١٠/١٢٠ وصحيح الترغيب والترهيب ١/٢٧٣.', p: 68 }
    ] },
    { n: 28, p: 68, ar: 'أَذْكَارُ النَّوْمِ', fr: 'Adhkār du coucher' },
    { n: 29, p: 77, ar: 'الدُّعَاءُ إِذَا تَقَلَّبَ لَيْلاً', fr: 'Invocation en se retournant la nuit' },
    { n: 30, p: 78, ar: 'دُعَاءُ الْفَزَعِ فِي النَّوْمِ وَمَنْ بُلِيَ بِالْوَحْشَةِ', fr: 'Invocation contre la frayeur nocturne et la solitude' },
    { n: 31, p: 78, ar: 'مَا يَفْعَلُ مَنْ رَأَى الرُّؤْيَا أَوِ الْحُلُمَ', fr: 'Que faire après un songe' },
    { n: 32, p: 79, ar: 'دُعَاءُ قُنُوتِ الْوِتْرِ', fr: 'Invocation du qunūt du witr' },
    { n: 33, p: 81, ar: 'الذِّكْرُ عَقِبَ السَّلَامِ مِنَ الْوِتْرِ', fr: 'Dhikr après le salām du witr' },
    { n: 34, p: 82, ar: 'دُعَاءُ الْهَمِّ وَالْحَزَنِ', fr: 'Invocation contre le souci et la tristesse' },
    { n: 35, p: 83, ar: 'دُعَاءُ الْكَرْبِ', fr: 'Invocation dans la détresse' },
    { n: 36, p: 84, ar: 'دُعَاءُ لِقَاءِ الْعَدُوِّ وَذِي السُّلْطَانِ', fr: "Invocation face à l'ennemi ou au détenteur du pouvoir" },
    { n: 37, p: 85, ar: 'دُعَاءُ مَنْ خَافَ ظُلْمَ السُّلْطَانِ', fr: "Invocation de qui craint l'injustice du dirigeant" },
