          <svg viewBox="0 0 24 24" style="width:13px;height:13px;fill:#B08D4F"><path d="M13.5 1c1.8 4.8-2.6 6.2-2.6 9.6 0 2.6 1.7 4.4 3.5 4.4s3.5-1.8 3.5-4.4c0-1.7-.9-2.6-1.7-3.5 2.6.9 4.4 3.5 4.4 6.1 0 3.5-2.6 6.1-6.1 6.1s-7-2.6-7-6.1c0-2.6 1.7-4.4 3.5-6.1-1.7-.9-2.6-2.6-2.6-4.4 0-2.6 1.7-1.7 5.2-1.7z"></path></svg>
          <span style="font-size:13px;font-weight:700;font-variant-numeric:tabular-nums">23</span>
        </button>
        <button onClick="{{ openNotifs }}" style="position:relative;width:34px;height:34px;border-radius:11px;background:#fff;border:1px solid #E4E1D8;display:flex;align-items:center;justify-content:center;flex-shrink:0" style-active="transform:scale(.92)">
          <svg viewBox="0 0 24 24" style="width:17px;height:17px;fill:none;stroke:#4F4B40;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round"><path d="M6.5 10a5.5 5.5 0 1111 0c0 4 1.5 5.5 1.5 5.5H5S6.5 14 6.5 10z"></path><path d="M10 18.5a2.2 2.2 0 004 0"></path></svg>
          <span style="position:absolute;top:-5px;right:-5px;min-width:17px;height:17px;padding:0 4px;border-radius:100px;background:#C0492F;color:#fff;font-size:9.5px;font-weight:700;align-items:center;justify-content:center;border:2px solid #F7F6F2;font-variant-numeric:tabular-nums;display:{{ notifBadgeShow }}">{{ notifBadge }}</span>
        </button>
        <button onClick="{{ openProfile }}" style="width:34px;height:34px;border-radius:11px;background:var(--sb-a);color:#fff;border:none;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:700;flex-shrink:0" style-active="transform:scale(.92)">{{ profInitial }}</button>
      </div>
    </div>

    <!-- hero : prochaine prière -->
    <div style="margin:0 20px 10px;background:linear-gradient(150deg,var(--sb-a) 0%,var(--sb-a2) 55%,var(--sb-a3) 100%);border-radius:20px;padding:18px 20px 0;color:#fff;box-shadow:0 18px 34px -16px rgba(4,55,41,.75)">
      <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:16px;padding-bottom:16px">
        <div>
          <div style="font-size:10.5px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:rgba(255,255,255,.62)">Prochaine prière</div>
          <div style="font-family:'Fraunces',Georgia,serif;font-size:34px;font-weight:600;letter-spacing:-0.01em;line-height:1.05;margin-top:2px">{{ nextName }}</div>
        </div>
        <div style="text-align:right;flex-shrink:0">
          <div style="font-size:28px;font-weight:700;letter-spacing:-0.025em;font-variant-numeric:tabular-nums;line-height:1">{{ nextTime }}</div>
          <div style="font-size:12px;font-weight:600;color:rgba(255,255,255,.66);margin-top:4px">dans {{ nextIn }}</div>
        </div>
      </div>
      <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;padding:11px 0 13px;border-top:1px solid rgba(255,255,255,.14)">
        <div style="font-size:11.5px;font-weight:600;color:rgba(255,255,255,.6)">Plage réservée · {{ nextSpan }} min</div>
        <div style="font-size:12.5px;font-weight:700;font-variant-numeric:tabular-nums">{{ nextStart }} → {{ nextEnd }}</div>
      </div>
    </div>

    <!-- rail des 5 prières -->
    <div style="display:flex;gap:5px;padding:0 20px 20px">
      <sc-for list="{{ prayerCells }}" as="p" hint-placeholder-count="5">
        <button onClick="{{ p.cycle }}" style="flex:1;border:1px solid;border-radius:12px;padding:9px 2px 8px;text-align:center;background:{{ p.bg }};border-color:{{ p.border }}" style-active="transform:scale(.95)">
          <div style="height:3px;border-radius:100px;margin:0 auto 7px;width:18px;background:{{ p.dot }}"></div>
          <div style="font-size:10px;font-weight:700;letter-spacing:0.05em;text-transform:uppercase;color:{{ p.ink }}">{{ p.name }}</div>
          <div style="font-size:14px;font-weight:700;font-variant-numeric:tabular-nums;letter-spacing:-0.02em;margin-top:2px;color:{{ p.ink }};text-decoration:{{ p.deco }}">{{ p.time }}</div>
        </button>
      </sc-for>
