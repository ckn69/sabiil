    var p = this.nP(), pr = this.prTimes();
    if (p.goals) this.nQueue({ key: 'goals', type: 'goals', pref: 'goals', title: '🎯 Objectifs du jour', msg: this.nGoalsMsg(), at: this.nNext(p.goalsTime), dest: { screen: 'today' } });
    else this.nDrop('goals');

    var m = p.adhMorningAuto ? Math.min(1439, (pr['Fajr'] || 300) + 30) : p.adhMorningTime;
    if (p.adhMorning) this.nQueue({ key: 'adh-m', type: 'adhkar', pref: 'adhMorning', title: '📿 Adhkār du matin', msg: 'N\'oublie pas tes adhkār du matin.', at: this.nNext(m), dest: { screen: 'adhkar', adhChap: 27 } });
    else this.nDrop('adh-m');

    var s = p.adhEveningAuto ? Math.max(1, (pr['Maghrib'] || 1294) - 45) : p.adhEveningTime;
    if (p.adhEvening) this.nQueue({ key: 'adh-s', type: 'adhkar', pref: 'adhEvening', title: '📿 Adhkār du soir', msg: 'N\'oublie pas tes adhkār du soir.', at: this.nNext(s), dest: { screen: 'adhkar', adhChap: 27 } });
