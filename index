  renderVals() {
    var self = this;
    var st = this.state;
    var screen = st.screen;
    var selPrayer = st.bufSel || 'Fajr';
    var bBefore = this.bufBefore(selPrayer);
    var bAfter = this.bufAfter(selPrayer);
    var fajrAfter = this.bufAfter('Fajr');
    var CM = {
      coran: { label: 'Coran', ic: 'coran' }, travail: { label: 'Travail', ic: 'travail' },
      arabe: { label: 'Arabe', ic: 'arabe' }, sport: { label: 'Sport', ic: 'sport' },
      sciences: { label: 'Sciences', ic: 'sciences' }, mosquee: { label: 'Mosquée', ic: 'mosquee' },
      personnel: { label: 'Personnel', ic: 'personnel' },
      rose: { label: 'Foyer', ic: 'broom' }
    };
    var mosque = null;
    for (var mq = 0; mq < this.MOSQUES.length; mq++) { if (this.MOSQUES[mq].id === st.mosque) mosque = this.MOSQUES[mq]; }
    if (!mosque) mosque = this.MOSQUES[0];
    var PR = mosque.times;
    var bandList = this.bands(PR);
    var ALLACTS = this.ACTIONS.concat(st.customActs || []);
    (st.customActs || []).forEach(function (a) { if (!CM[a.cat]) CM[a.cat] = { label: a.label, ic: a.ic }; });
    var ACT = {};
    ALLACTS.forEach(function (a) { ACT[a.k] = a; });

    var dayKey = st.cur;
    var allEvents = (st.events[dayKey] || []).map(function (e) {
      var m = CM[e.cat] || CM.travail;
      return { id: e.id, name: e.name, s: e.s, e: e.e, cat: e.cat, catLabel: m.label, ic: e.ic || m.ic, key: dayKey + '|' + e.id, grp: e.grp || '', grpColor: (e.gid && (st.gcolors || {})[e.gid]) || e.grpColor || '',
        loc: e.loc || '', rem: e.rem === undefined ? -1 : e.rem };
    });

    // ── prochaine prière ──
    var next = null;
    for (var i = 0; i < PR.length; i++) { if (PR[i].m > this.NOW) { next = PR[i]; break; } }
    if (!next) next = PR[0];
    var diff = next.m - this.NOW;
    var nh = Math.floor(diff / 60), nm = diff % 60;

    // ── rail prières ──
    var STY = {
      mosque:  { bg: 'var(--sb-a)', ink: '#FFFFFF', border: 'var(--sb-a)', dot: 'rgba(255,255,255,.55)', deco: 'none' },
      group:   { bg: '#FBEEDF', ink: '#8A5212', border: '#F0DCBF', dot: '#D98A2B', deco: 'none' },
      alone:   { bg: '#F7E4DE', ink: '#A33D25', border: '#EDCEC5', dot: '#C0492F', deco: 'none' },
      current: { bg: '#FFFFFF', ink: 'var(--sb-ai)', border: 'var(--sb-a)', dot: '#B08D4F', deco: 'none' },
      pending: { bg: '#FFFFFF', ink: '#8A8578', border: '#E4E1D8', dot: '#E4E1D8', deco: 'none' }
    };
    var prayerCells = PR.map(function (p) {
      var s = STY[st.ps[p.n]] || STY.pending;
      return {
        name: p.n, time: self.hhmm(p.m), bg: s.bg, ink: s.ink, border: s.border, dot: s.dot, deco: s.deco,
        cycle: function () { self.cycle(p.n); }
      };
    });

    // ── stats ──
    var groupCount = 0;
    Object.keys(st.ps).forEach(function (k) { if (st.ps[k] === 'group' || st.ps[k] === 'mosque') groupCount++; });
    var stats = [
      { num: st.pagesToday, unit: 'pages', label: 'Coran lu', ink: '#1A1610' },
      { num: 48, unit: 'min', label: 'Étude', ink: '#1A1610' },
      { num: 8, unit: '/15', label: 'Adhkār', ink: '#1A1610' },
      { num: groupCount, unit: '/5', label: 'Prières en groupe', ink: 'var(--sb-a)' }
    ].map(function (s, ix) {
      s.bb = ix < 2 ? '1px solid #EFEDE6' : 'none';
      s.br = ix % 2 === 0 ? '1px solid #EFEDE6' : 'none';
      return s;
    });

    // ── blocs du jour ──
    var doneCount = 0;
    var sortedEvents = allEvents.slice().sort(function (a, b) { return a.s - b.s; });
    // fusion des événements et des repères de prière (vue "entre quelles prières")
    var merged = [];
    PR.forEach(function (p) { merged.push({ t: p.m, pr: p }); });
    sortedEvents.forEach(function (e) { merged.push({ t: e.s, ev: e }); });
    merged.sort(function (a, b) { return (a.t - b.t) || ((a.pr ? 0 : 1) - (b.pr ? 0 : 1)); });
    merged.forEach(function (m, i) {
      if (!m.pr) return;
      var c = 0;
      for (var j = i + 1; j < merged.length && !merged[j].pr; j++) c++;
      m.count = c === 0 ? 'rien de prévu' : (c === 1 ? '1 bloc' : c + ' blocs');
    });
    var evLast = merged.length - 1;
    var blocks = merged.map(function (m, ix) {
      var divider = ix === evLast ? 'none' : '1px solid #EFEDE6';
      if (m.pr) {
        var ps = STY[st.ps[m.pr.n]] || STY.pending;
        return {
          prayerShow: 'flex', rowShow: 'none', divider: divider,
          prName: m.pr.n, prTime: self.hhmm(m.pr.m), prCount: m.count,
          prDot: ps.dot === '#E4E1D8' ? '#C9C4B4' : ps.dot,
          prInk: st.ps[m.pr.n] && st.ps[m.pr.n] !== 'pending' ? 'var(--sb-ai)' : '#8A8578'
        };
      }
      var e = m.ev;
      var d = !!st.done[e.key];
      if (d) doneCount++;
      var t = self.tint(e.cat);
      var mins = e.e - e.s;
      var dur = mins >= 60 ? (mins % 60 === 0 ? Math.floor(mins / 60) + 'h' : Math.floor(mins / 60) + 'h' + (mins % 60)) : mins + ' min';
      return {
        prayerShow: 'none', rowShow: 'flex',
        name: e.name, cat: e.catLabel, time: self.hhmm(e.s), dur: dur,
        divider: divider,
        bg: d ? '#EFEDE6' : t.bg, ink: d ? '#B6B1A5' : t.ink,
        d: self.IC[e.ic][0], d2: self.IC[e.ic][1],
        nameInk: d ? '#B6B1A5' : '#1A1610', timeInk: d ? '#C9C4B4' : '#4F4B40',
        deco: d ? 'line-through' : 'none',
        checkBg: d ? 'var(--sb-a)' : '#FFFFFF', checkBorder: d ? 'var(--sb-a)' : '#DEDBD1',
        checkInk: d ? '#FFFFFF' : 'transparent',
