    <div style="display:flex;align-items:flex-start;gap:12px;padding:6px 20px 18px">
      <div style="flex:1;min-width:0">
        <div style="font-size:11px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#8A8578">As-salāmu ʿalaykum</div>
        <div style="font-family:'Fraunces',Georgia,serif;font-size:27px;font-weight:600;letter-spacing:-0.015em;line-height:1.1;margin-top:3px">Thibaut</div>
        <div style="display:flex;align-items:center;gap:7px;flex-wrap:wrap;margin-top:5px">
          <span style="font-size:13px;color:#8A8578;font-weight:500;display:{{ dateGregShow }}">Vendredi 14 juin</span>
          <button onClick="{{ openHijri }}" style="display:{{ dateHijriShow }};align-items:center;gap:5px;background:#EFEDE6;border:1px solid #E4E1D8;border-radius:100px;padding:3px 10px" style-active="opacity:.65">
            <span style="font-size:11px;line-height:1">{{ hijriFlag }}</span>
            <span style="font-size:11.5px;font-weight:700;color:#4F4B40;letter-spacing:-0.01em">{{ hijriChip }}</span>
          </button>
        </div>
      </div>
      <div style="display:flex;align-items:center;gap:8px;padding-top:4px">
