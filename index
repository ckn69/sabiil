    var out = [], re = /<strong>(.*?)<\/strong>/g, last = 0, m;
    while ((m = re.exec(html)) !== null) {
      if (m.index > last) out.push({ t: html.slice(last, m.index), w: '500', c: '#373329' });
      out.push({ t: m[1], w: '700', c: '#1A1610' });
      last = m.index + m[0].length;
    }
