          });
        });
        var pcur = st.ps[pp.n] || 'pending';
        var psb = SB[pcur] || SB.pending;
        pdet = {
          name: pp.n, adhan: self.hhmm(pp.m), range: self.hhmm(pa) + ' – ' + self.hhmm(pb),
          span: (pb - pa) + ' min', dayLabel: self.dayLabel(dayKey),
          status: psb.status, statusBg: psb.bg, statusInk: psb.ink, statusBorder: psb.border,
          leaveAt: self.hhmm(pa),
          steps: psteps,
          choices: PS_CHOICES.map(function (c) {
            var on = c.k === pcur;
            return {
              label: c.label,
              bg: on ? (SB[c.k] || SB.pending).bg : '#FFFFFF',
              ink: on ? (SB[c.k] || SB.pending).ink : '#6B6759',
              border: on ? (SB[c.k] || SB.pending).border : '#E4E1D8',
              weight: on ? '800' : '600',
              pick: function () {
                var ns = Object.assign({}, st.ps); ns[pp.n] = c.k;
                self.setState({ ps: ns });
                self.toast(pp.n + ' · ' + c.label.toLowerCase());
              }
            };
          }),
          settings: function () { self.setState({ pdet: null, modal: 'prayer', bufSel: pp.n }); }
        };
      }
    }

    // grouper les blocs qui se chevauchent en colonnes côte à côte
    var byStart = allEvents.slice().sort(function (a, b) { return a.s - b.s || a.e - b.e; });
    var clusters = [], cluster = [], clusterEnd = -1;
    byStart.forEach(function (e) {
      if (cluster.length && e.s >= clusterEnd) { clusters.push(cluster); cluster = []; clusterEnd = -1; }
      cluster.push(e);
      clusterEnd = Math.max(clusterEnd, e.e);
    });
    if (cluster.length) clusters.push(cluster);

    var eventBlocks = [];
    clusters.forEach(function (cl) {
      var colEnds = [];
      var placed = cl.map(function (e) {
        var col = -1;
        for (var c = 0; c < colEnds.length; c++) { if (e.s >= colEnds[c]) { col = c; break; } }
        if (col === -1) { col = colEnds.length; colEnds.push(0); }
        colEnds[col] = e.e;
        return { e: e, col: col };
      });
      var cols = colEnds.length;
      placed.forEach(function (p) {
        var t = self.tint(p.e.cat);
        var adjOn = !!(st.adj && st.adj.kind === 'ev' && st.adj.dk === dayKey && st.adj.id === p.e.id);
        var mChips = [];
        if (p.e.loc) mChips.push(p.e.loc);
        var mRem = self.remLabel(p.e.rem);
        if (mRem) mChips.push('Rappel ' + mRem.toLowerCase());
        if (p.e.grp) mChips.push(p.e.grp);
        var mTxt = mChips.join(' · ');
        eventBlocks.push({
          name: p.e.name, bg: t.bg, ink: t.ink, bar: t.bar,
          meta: mTxt, locShow: p.e.loc ? 'block' : 'none',
          metaShow: mTxt && (p.e.e - p.e.s) >= 40 ? 'flex' : 'none',
          sel: adjOn ? 'var(--sb-a)' : 'transparent',
          hndShow: adjOn ? 'flex' : 'none',
          cursor: adjOn ? 'grab' : 'pointer',
          touch: adjOn ? 'none' : 'pan-y',
          stop: function (ev) { ev.stopPropagation(); },
          dbl: function (ev) {
            ev.preventDefault(); ev.stopPropagation();
            self.setState({ detail: { dk: dayKey, id: p.e.id } });
          },
          resizeTop: function (ev) { self.startDrag(ev, p.e, 'resizeTop'); },
          range: self.hhmm(p.e.s) + ' – ' + self.hhmm(p.e.e),
          top: self.px(p.e.s), h: ((p.e.e - p.e.s) / 60 * self.HH).toFixed(1) + 'px',
          left: (p.col * 100 / cols).toFixed(3) + '%',
          width: cols === 1 ? '100%' : 'calc(' + (100 / cols).toFixed(3) + '% - 3px)',
          evRef: p.e, ring: 'none', alertShow: 'none',
          grpShow: p.e.grp ? 'block' : 'none', grpColor: p.e.grpColor || t.bar,
          opacity: st.done[dayKey + '|' + p.e.id] ? '.55' : '1',
          z: st.dragging === p.e.id ? '8' : (adjOn ? '7' : '2'),
          shadow: st.dragging === p.e.id ? '0 8px 18px -6px rgba(26,22,16,.4)' : 'none',
          press: function (ev) {
            if (adjOn) { self.startDrag(ev, p.e, 'move'); return; }
            self.longPress(ev, function () { self.toggleAdj({ kind: 'ev', dk: dayKey, id: p.e.id }); });
          },
          resize: function (ev) { self.startDrag(ev, p.e, 'resize'); }
        });
      });
    });

    var views = [
      { key: 'day', label: 'Jour' }, { key: 'three', label: '3 j.' },
      { key: 'week', label: 'Sem.' }, { key: 'month', label: 'Mois' },
      { key: 'timeline', label: 'Liste' }
    ].map(function (v, ix, arr) {
      var on = st.view === v.key;
      var FULL = { day: 'Jour', three: 'Trois jours', week: 'Semaine', month: 'Mois', timeline: 'Liste' };
      return {
        key: v.key, label: v.label, full: FULL[v.key],
        bg: on ? '#FFFFFF' : 'transparent', ink: on ? '#1A1610' : '#8A8578',
        shadow: on ? '0 1px 3px rgba(26,22,16,.1)' : 'none',
        rowInk: on ? '#1A1610' : '#4F4B40',
        checkShow: on ? 'block' : 'none',
        divider: ix === arr.length - 1 ? 'none' : '1px solid #EFEDE6',
        pick: function () { self.setState({ view: v.key, detail: null, modal: '' }); }
      };
    });

    var wk = this.weekKeys(st.cur);
    var weekStrip = wk.map(function (k, ix) {
      var on = k === st.cur;
      var isT = k === self.TODAY_KEY;
      var cnt = (st.events[k] || []).length;
      return {
        dow: self.DOWS_S[ix], num: st.dateMode === 'hijri' ? self.hijriDayNum(k) : self.pd(k).getDate(),
        bg: on ? 'var(--sb-a)' : '#FFFFFF', border: on ? 'var(--sb-a)' : (isT ? '#B08D4F' : '#E4E1D8'),
        ink: on ? '#FFFFFF' : '#1A1610', dim: on ? 'rgba(255,255,255,.65)' : '#A8A399',
        dotBg: cnt ? (on ? 'rgba(255,255,255,.75)' : '#C9C4B4') : 'transparent',
        pick: function () { self.setState({ cur: k, detail: null }); }
      };
    });

    // ── vues multi-jours ──
    var HH2 = 34;
    var px2 = function (m) { return (m / 60 * HH2).toFixed(1) + 'px'; };
    var hours2 = [];
    for (var h2 = 0; h2 <= 23; h2++) hours2.push({ label: String(h2).padStart(2, '0'), top: px2(h2 * 60) });

    var colKeys = st.view === 'three' ? [st.cur, this.addDays(st.cur, 1), this.addDays(st.cur, 2)]
      : (st.view === 'week' ? wk : []);
    var wide = st.view === 'three';
    var dayCols = colKeys.map(function (k) {
      var evs = (st.events[k] || []).slice().sort(function (a, b) { return a.s - b.s; });
      var isCur = k === st.cur, isT = k === self.TODAY_KEY;
      return {
        dow: self.DOWS_S[self.mdow(k)], num: self.pd(k).getDate(),
        headBg: isCur ? 'var(--sb-a)' : (isT ? '#F7EFDD' : 'transparent'),
        headInk: isCur ? '#FFFFFF' : '#1A1610',
        headDim: isCur ? 'rgba(255,255,255,.7)' : '#A8A399',
        pick: function () { self.setState({ cur: k, view: 'day', detail: null }); },
        nowShow: (isT && st.view !== 'month') ? 'block' : 'none',
        nowTop: px2(self.NOW),
        bands: PR.map(function (p) {
          var s = (k === self.TODAY_KEY ? SB[st.ps[p.n]] : null) || SB.pending;
          var a = Math.max(0, p.m - self.bufBefore(p.n)), b = Math.min(1440, p.m + self.bufAfter(p.n));
          return {
            label: wide ? p.n : p.n.slice(0, 3), bg: s.bg, border: s.border, ink: s.ink,
            adhanTop: ((p.m - a) / 60 * HH2).toFixed(1) + 'px',
            top: px2(a), h: Math.max(8, (b - a) / 60 * HH2).toFixed(1) + 'px'
          };
        }),
        blocks: evs.map(function (e) {
          var t = self.tint(e.cat);
          return {
            name: e.name, fs: wide ? '9px' : '8px', bg: t.bg, bar: t.bar, ink: t.ink,
            top: px2(e.s), h: Math.max(9, (e.e - e.s) / 60 * HH2).toFixed(1) + 'px',
            open: function () { self.setState({ cur: k, detail: { dk: k, id: e.id } }); }
          };
        })
      };
    });

    // ── vue mois ──
    var mRef = this.pd(st.cur);
    var mFirstKey = mRef.getFullYear() + '-' + String(mRef.getMonth() + 1).padStart(2, '0') + '-01';
    var mStart = this.addDays(mFirstKey, -this.mdow(mFirstKey));
    var monthCells = [];
    for (var mi = 0; mi < 42; mi++) {
      (function (i) {
        var k = self.addDays(mStart, i);
        var d = self.pd(k);
        var inM = d.getMonth() === mRef.getMonth();
        var evs = st.events[k] || [];
        var isCur = k === st.cur, isT = k === self.TODAY_KEY;
        monthCells.push({
          num: d.getDate(),
          bg: isCur ? 'var(--sb-a)' : (isT ? '#F7EFDD' : '#FFFFFF'),
          border: isCur ? 'var(--sb-a)' : (isT ? '#EADFC4' : '#E9E6DE'),
          ink: isCur ? '#FFFFFF' : (inM ? '#1A1610' : '#C9C4B4'),
          dots: evs.slice(0, 4).map(function (e) {
            return { bg: isCur ? 'rgba(255,255,255,.85)' : self.tint(e.cat).bar };
          }),
          pick: function () { self.setState({ cur: k, view: 'day', detail: null }); }
        });
      })(mi);
    }

    // ── créneaux vides cliquables ──
    var emptyCells = [];
    for (var ec = 0; ec <= 23; ec++) {
      (function (hh) {
        emptyCells.push({
          top: self.px(hh * 60), h: self.HH + 'px',
          add: function () { self.openNew(st.cur, hh * 60); }
        });
      })(ec);
    }

    // ── fiche détail d'un bloc ──
    var det = null;
    if (st.detail) {
      var dl = (st.events[st.detail.dk] || []).filter(function (x) { return x.id === st.detail.id; })[0];
      if (dl) {
        var dt = this.tint(dl.cat), dm = CM[dl.cat] || CM.travail;
        var dkey = st.detail.dk + '|' + dl.id, isDone = !!st.done[dkey];
        var dmin = dl.e - dl.s;
        det = {
          name: dl.name, cat: dm.label, bg: dt.bg, ink: dt.ink, bar: dt.bar,
          d: this.IC[dl.ic || dm.ic][0], d2: this.IC[dl.ic || dm.ic][1],
          range: this.hhmm(dl.s) + ' – ' + this.hhmm(dl.e),
          dayLabel: this.dayLabel(st.detail.dk),
          dur: dmin >= 60 ? (dmin % 60 === 0 ? Math.floor(dmin / 60) + 'h' : Math.floor(dmin / 60) + 'h' + (dmin % 60)) : dmin + ' min',
          loc: dl.loc || '', locShow: dl.loc ? 'flex' : 'none',
          locDiv: dl.loc && (this.remLabel(dl.rem) || dl.note || dl.tel) ? '1px solid #EFEDE6' : 'none',
          remLabel: this.remLabel(dl.rem), remShow: this.remLabel(dl.rem) ? 'flex' : 'none',
          remDiv: this.remLabel(dl.rem) && (dl.note || dl.tel) ? '1px solid #EFEDE6' : 'none',
          note: dl.note || '', noteShow: dl.note ? 'flex' : 'none',
          noteDiv: dl.note && dl.tel ? '1px solid #EFEDE6' : 'none',
          tel: dl.tel || '', telShow: dl.tel ? 'flex' : 'none',
          telHref: 'tel:' + String(dl.tel || '').split(' ').join(''),
          metaShow: dl.loc || this.remLabel(dl.rem) || dl.note || dl.tel ? 'flex' : 'none',
          doneLabel: isDone ? 'Marquer non fait' : 'Marquer comme fait',
          doneBg: isDone ? '#EFEDE6' : 'var(--sb-a)', doneInk: isDone ? '#4F4B40' : '#FFFFFF',
          toggle: function () {
            var n = Object.assign({}, st.done); n[dkey] = !n[dkey];
            self.setState({ done: n, detail: null });
            self.toast(n[dkey] ? dl.name + ' · fait' : dl.name + ' · à refaire');
          },
          conflict: (function () {
            var b = null;
            for (var ci = 0; ci < bandList.length; ci++) {
              var bb = bandList[ci];
              if (dl.s < bb.b && dl.e > bb.a) b = bb;
            }
            if (!b) return null;
            var len = dl.e - dl.s;
            return {
              name: b.n,
              range: self.hhmm(b.a) + ' – ' + self.hhmm(b.b),
              beforeLabel: 'Avant · ' + self.hhmm(Math.max(0, b.a - len)),
              afterLabel: 'Après · ' + self.hhmm(b.b),
              moveBefore: function () {
                var ns = Math.max(0, b.a - len);
                self.patchEvent(st.detail.dk, dl.id, { s: ns, e: ns + len });
                self.setState({ detail: null }); self.toast(dl.name + ' déplacé avant ' + b.n);
              },
              moveAfter: function () {
                var ne = Math.min(1440, b.b + len);
                self.patchEvent(st.detail.dk, dl.id, { s: b.b, e: ne });
                self.setState({ detail: null }); self.toast(dl.name + ' déplacé après ' + b.n);
              }
            };
          })(),
          hadith: (function () {
            var a = null;
            self.ACTIONS.forEach(function (x) { if (x.cat === dl.cat) { if (!a) a = x; } });
            if (!a) return null;
            return { title: a.title, text: '« ' + a.hadith + ' »', src: a.src };
          })(),
          edit: function () {
            self.setState({
              modal: 'block', detail: null,
              nb: { name: dl.name, start: dl.s, end: dl.e, ic: dl.ic || dm.ic, cat: dl.cat, rec: 'once', date: st.detail.dk,
                rem: dl.rem === undefined ? -1 : dl.rem, loc: dl.loc || '', note: dl.note || '', tel: dl.tel || '', agenda: false,
                editing: { dk: st.detail.dk, id: dl.id } }
            });
          },
          del: function () { self.removeEvent(st.detail.dk, dl.id); self.toast(dl.name + ' supprimé'); }
        };
      }
    }

    // ── habitudes ──
    var habitsDone = 0;
    var habits = this.HAB.map(function (h) {
      var d = !!st.hd[h.id];
      if (d) habitsDone++;
      var t = self.tint(h.cat);
      var df = self.DIFF[h.diff];
      return {
        name: h.name, streak: h.streak, diffLabel: df.label, xp: df.xp,
        bg: t.bg, ink: t.ink, d: self.IC[h.ic][0], d2: self.IC[h.ic][1],
        cardBg: d ? '#F2F7F4' : '#FFFFFF', nameInk: d ? '#4F4B40' : '#1A1610',
        checkBg: d ? 'var(--sb-a)' : '#FFFFFF', checkBorder: d ? 'var(--sb-a)' : '#DEDBD1',
        checkInk: d ? '#FFFFFF' : '#DEDBD1',
        hist: h.hist.map(function (v) { return { bg: v ? '#8FC4AE' : '#EFEDE6' }; }),
        toggle: function () {
          var n = Object.assign({}, st.hd);
          n[h.id] = !n[h.id];
          var gain = n[h.id] ? 1 : -1;
          self.setState({ hd: n, xp: Math.max(0, st.xp + gain * df.xp), coins: Math.max(0, st.coins + gain * df.c) });
          if (gain > 0) self.toast('+' + df.xp + ' XP · +' + df.c + ' pièces');
        }
      };
    });
    var xpNeed = st.lvl * 120;
    var rewards = this.REW.map(function (r) {
      var ok = st.coins >= r.price;
      var t = self.tint(r.cat);
      return {
        name: r.name, price: r.price + ' ⬤', bg: t.bg, ink: t.ink,
        d: self.IC[r.ic][0], d2: self.IC[r.ic][1],
        border: ok ? '#DEC9A0' : '#E4E1D8', priceInk: ok ? '#8A5E1F' : '#B6B1A5',
        buy: function () {
          if (!ok) { self.toast('Il te manque ' + (r.price - st.coins) + ' pièces'); return; }
          self.setState({ coins: st.coins - r.price });
          self.toast(r.name + ' débloqué');
        }
      };
    });

    // ── apprendre ──
    var prog = this.PROG[st.prog];
    var INFO = {};
    Object.keys(this.PROG).forEach(function (pk) {
      self.PROG[pk].levels.forEach(function (lv) {
        lv.modules.forEach(function (m) { INFO[m.name] = self.modInfo(m.name); });
      });
    });
    var totalDone = 0, totalAll = 0;
    prog.levels.forEach(function (lv) {
      lv.modules.forEach(function (m) { totalDone += INFO[m.name].done; totalAll += INFO[m.name].total; });
    });
    var learnPctNum = totalAll ? Math.round(totalDone / totalAll * 100) : 0;
    var lv1 = prog.levels[0];
    var lv1Done = 0, lv1All = 0;
    lv1.modules.forEach(function (m) { lv1Done += INFO[m.name].done; lv1All += INFO[m.name].total; });

    var programs = Object.keys(this.PROG).map(function (k) {
      var on = st.prog === k;
      return {
        label: self.PROG[k].label, d: self.IC[self.PROG[k].ic][0], d2: self.IC[self.PROG[k].ic][1],
        bg: on ? '#FFFFFF' : 'transparent', ink: on ? '#1A1610' : '#8A8578',
        shadow: on ? '0 1px 3px rgba(26,22,16,.1)' : 'none',
        pick: function () { self.setState({ prog: k }); }
      };
    });

    var levels = prog.levels.map(function (lv, lix) {
      var d = 0, a = 0;
      lv.modules.forEach(function (m) { d += INFO[m.name].done; a += INFO[m.name].total; });
      var locked = lix > 0 && lv1Done < lv1All;
      var last = lv.modules.length - 1;
      return {
        eyebrow: lv.eyebrow, title: lv.title, desc: lv.desc,
        pct: Math.round(d / a * 100) + '%',
        opacity: locked ? '.55' : '1',
        lockShow: locked ? 'block' : 'none',
        badgeBg: locked ? '#EFEDE6' : 'var(--sb-abg)', badgeInk: locked ? '#8A8578' : 'var(--sb-ai)',
        modules: lv.modules.map(function (m, ix) {
          var t = self.tint(m.cat);
          var nf = INFO[m.name];
          var unit = m.unit || 'leçons';
          var pct = Math.round(nf.done / nf.total * 100);
          var status = nf.done === 0 ? 'Nouveau' : (nf.done === nf.total ? 'Terminé' : nf.done + '/' + nf.total);
          return {
            name: m.name, meta: nf.src + ' · ' + nf.total + ' ' + unit + (nf.dur ? ' · ' + nf.dur : ''),
            bg: t.bg, ink: t.ink, d: self.IC[m.ic][0], d2: self.IC[m.ic][1],
            pct: pct + '%', fill: nf.done === nf.total ? 'var(--sb-a)' : '#B08D4F',
            status: status,
            statusInk: nf.done === nf.total ? 'var(--sb-a)' : (nf.done === 0 ? '#B6B1A5' : '#8A5E1F'),
            divider: ix === last ? 'none' : '1px solid #EFEDE6',
            open: function () {
              if (locked) { self.toast('Termine le niveau 1 pour débloquer'); return; }
              self.setState({ course: m.name, ctab: 'audio', noteDraft: st.cnotes[m.name] || '' });
              self.measureCourse(m.name);
            }
          };
        })
      };
    });

    var badges = this.BADGES.map(function (b) {
      return {
        name: b.name, d: self.IC[b.ic][0], d2: self.IC[b.ic][1],
        bg: b.on ? '#F7EFDD' : '#EFEDE6', ink: b.on ? '#B08D4F' : '#B6B1A5',
        border: b.on ? '#EADFC4' : '#E4E1D8', opacity: b.on ? '1' : '.6',
        show: function () { self.toast(b.on ? b.name + ' · débloqué' : b.name + ' · encore verrouillé'); }
      };
    });

    // ── lecteur audio global ──
    var pl = st.player;
    var mini = null;
    if (pl) {
      var pc = this.courseOf(pl.course);
      var pLes = pc.lessons[pl.idx];
      var pMod = this.modDecl(pl.course) || {};
      var pSeed = pMod.done || 0;
      mini = {
        title: pLes ? pLes.t : '',
        course: pl.course,
        pct: Math.round(pl.pos / (pl.dur || 1) * 100) + '%',
        pos: this.mmss(pl.pos), dur: this.mmss(pl.dur),
        playing: pl.playing,
        playD: pl.playing ? 'M8.5 6h3v12h-3zM14 6h3v12h-3z' : 'M7.5 5v14l11-7z',
        rateLabel: pl.rate === 1 ? '1×' : (pl.rate === 1.5 ? '1,5×' : '2×'),
        lessonN: String(pl.idx + 1).padStart(2, '0'),
        lessonTotal: pc.lessons.length,
        posSec: pl.pos, durSec: pl.dur,
        remain: '-' + this.mmss(Math.max(0, pl.dur - pl.pos)),
        catD: (this.IC[pMod.ic] || this.IC.grad)[0],
        catD2: (this.IC[pMod.ic] || this.IC.grad)[1],
        src: pMod.src || 'Sabīl',
        hadith: "Quiconque emprunte un chemin à la recherche d'une science, Allāh lui facilite un chemin vers le Paradis.",
        hadithSrc: 'Muslim · 2699',
        seek: function (e) { self.pSeek(Number(e.target.value)); },
        fwd: function () { self.pNudge(15); },
        prevLesson: function () {
          if (pl.idx === 0) { self.setState({ player: Object.assign({}, pl, { pos: 0 }) }); return; }
          self.playLesson(pl.course, pl.idx - 1);
        },
        nextLesson: function () {
          if (pl.idx + 1 >= pc.lessons.length) { self.toast('Dernière leçon de ce cours'); return; }
          self.playLesson(pl.course, pl.idx + 1);
        },
        prevOp: pl.idx === 0 ? '.4' : '1',
        nextOp: pl.idx + 1 >= pc.lessons.length ? '.4' : '1',
        openFull: function () { self.setState({ pfull: true }); },
        minimize: function () { self.setState({ pfull: false }); },
        queue: pc.lessons.map(function (l, i) {
          var isCur = i === pl.idx;
          var dn = self.heard(pl.course, i, pSeed);
          return {
            n: String(i + 1).padStart(2, '0'), title: l.t,
            dur: self.lessonDur(pl.course, i, l) ? self.mmss(self.lessonDur(pl.course, i, l)) : '',
            numBg: isCur ? 'var(--sb-a)' : (dn ? 'var(--sb-abg)' : '#EFEDE6'),
            numInk: isCur ? '#FFFFFF' : (dn ? 'var(--sb-ai)' : '#8A8578'),
