    try { window.localStorage.setItem('sabil.mushaf.v1', JSON.stringify(d)); } catch (e) {}
  }

  goPage(n) {
    var self = this, p = Math.max(1, Math.min(604, n));
    var patch = { mi: p, msVerse: null, msSheet: '', qmSel: '' };
    if (this.state.msMode === 'ayah') { patch.rdSurah = this.surahNumAt(p); patch.rdSel = 0; this.rdPersist({ surah: patch.rdSurah }); }
    this.setState(patch, function () {
