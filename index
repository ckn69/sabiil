<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="crossorigin" />
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&display=swap" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Amiri+Quran&family=Scheherazade+New:wght@400;700&display=swap" rel="stylesheet" />
<style>
  @font-face{font-family:'UthmanicHafs';src:url('assets/fonts/UthmanicHafs.woff2') format('woff2'),url('assets/fonts/UthmanicHafs.ttf') format('truetype');font-display:swap}
  :root{--sb-a:#0E7C5A;--sb-a2:#075E45;--sb-a3:#043729;--sb-ai:#0B6349;--sb-abg:#E6F1EB;--sb-abd:#CBE3D6}
  *{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
  body{background:#0B2B21;-webkit-font-smoothing:antialiased}
  a{color:var(--sb-a);text-decoration:none}
  a:hover{color:var(--sb-a2);text-decoration:underline}
  button{font-family:inherit;cursor:pointer}
  input{font-family:inherit}
  ::-webkit-scrollbar{display:none}
  input[type=range]{-webkit-appearance:none;appearance:none;width:100%;height:4px;border-radius:100px;background:#E4E1D8;outline:none;margin:0}
  input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:18px;height:18px;border-radius:100px;background:var(--sb-a);border:2px solid #F7F6F2;box-shadow:0 1px 4px rgba(26,22,16,.25);cursor:pointer}
  input[type=range]::-moz-range-thumb{width:18px;height:18px;border-radius:100px;background:var(--sb-a);border:2px solid #F7F6F2;cursor:pointer}
  select{font-family:inherit}
  @keyframes sb-pulse{0%,100%{opacity:1}50%{opacity:.35}}
  @keyframes sb-rise{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
  @keyframes sb-spin{to{transform:rotate(360deg)}}
  @keyframes sb-pop{from{opacity:0;transform:translate(-50%,6px) scale(.96)}to{opacity:1;transform:translate(-50%,0) scale(1)}}
  @keyframes sb-wave{0%,100%{transform:scaleY(.45)}50%{transform:scaleY(1)}}
</style>
</helmet>

<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;padding:20px;font-family:'Plus Jakarta Sans',system-ui,sans-serif;background:radial-gradient(120% 90% at 50% 0%,#124635 0%,#08211A 70%)">
<div style="width:min(400px,100%);height:min(848px,calc(100vh - 40px));background:#13150F;border-radius:44px;padding:9px;box-shadow:0 40px 90px -24px rgba(0,0,0,.65),0 0 0 1px rgba(255,255,255,.07)">
<div style="width:100%;height:100%;background:#F7F6F2;border-radius:36px;overflow:hidden;display:flex;flex-direction:column;position:relative;color:#1A1610">

  <div style="height:44px;display:flex;justify-content:space-between;align-items:flex-end;padding:0 26px 7px;flex-shrink:0;font-size:13px;font-weight:600;letter-spacing:-0.01em">
    <span>9:41</span>
    <div style="display:flex;align-items:center;gap:6px">
      <span style="font-size:11px;font-weight:700">5G</span>
      <div style="width:22px;height:10px;border:1px solid #1A1610;border-radius:3px;padding:1.5px"><div style="width:80%;height:100%;background:#1A1610;border-radius:1px"></div></div>
    </div>
  </div>

  <!-- ═══════════ MINI-LECTEUR GLOBAL ═══════════ -->
  <sc-if value="{{ miniShow }}" hint-placeholder-val="{{ false }}">
  <div style="flex-shrink:0;margin:0 12px 6px;background:#1A1610;border-radius:14px;overflow:hidden;box-shadow:0 10px 24px -12px rgba(26,22,16,.7);position:relative;z-index:25">
    <div style="display:flex;align-items:center;gap:9px;padding:8px 9px 9px">
      <button onClick="{{ mini.toggle }}" style="width:34px;height:34px;border-radius:11px;border:none;background:var(--sb-a);display:flex;align-items:center;justify-content:center;flex-shrink:0" style-active="transform:scale(.92)">
        <svg viewBox="0 0 24 24" style="width:15px;height:15px;fill:#fff"><path d="{{ mini.playD }}"></path></svg>
      </button>
      <button onClick="{{ mini.openFull }}" style="flex:1;min-width:0;background:none;border:none;text-align:left;padding:0">
        <div style="font-size:12.5px;font-weight:600;letter-spacing:-0.012em;color:#fff;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{ mini.title }}</div>
        <div style="display:flex;align-items:center;gap:6px;margin-top:3px">
          <span style="font-size:10px;font-weight:700;font-variant-numeric:tabular-nums;color:#E3C063;flex-shrink:0">{{ mini.pos }}</span>
          <span style="font-size:10px;font-weight:500;color:rgba(255,255,255,.45);flex-shrink:0">/ {{ mini.dur }}</span>
          <span style="font-size:10px;font-weight:500;color:rgba(255,255,255,.45);overflow:hidden;text-overflow:ellipsis;white-space:nowrap">· {{ mini.course }}</span>
        </div>
      </button>
      <button onClick="{{ mini.back }}" style="width:30px;height:30px;border-radius:9px;border:none;background:rgba(255,255,255,.1);display:flex;align-items:center;justify-content:center;flex-shrink:0">
        <svg viewBox="0 0 24 24" style="width:14px;height:14px;fill:none;stroke:#fff;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round"><path d="M4 11.5A8 8 0 114.6 15"></path><path d="M3.5 6v5.5H9"></path></svg>
      </button>
      <button onClick="{{ mini.cycleRate }}" style="min-width:32px;height:30px;padding:0 7px;border-radius:9px;border:none;background:rgba(255,255,255,.1);color:#fff;font-size:11px;font-weight:700;flex-shrink:0;font-variant-numeric:tabular-nums">{{ mini.rateLabel }}</button>
      <button onClick="{{ mini.close }}" style="width:30px;height:30px;border-radius:9px;border:none;background:none;display:flex;align-items:center;justify-content:center;flex-shrink:0">
        <svg viewBox="0 0 24 24" style="width:14px;height:14px;fill:none;stroke:rgba(255,255,255,.5);stroke-width:2.2;stroke-linecap:round"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
    </div>
    <div style="height:2.5px;background:rgba(255,255,255,.12)">
      <div style="height:100%;background:var(--sb-a);width:{{ mini.pct }};transition:width .95s linear"></div>
    </div>
  </div>
  </sc-if>

  <!-- ═══════════ LECTEUR PLEINE PAGE ═══════════ -->
  <sc-if value="{{ fullShow }}" hint-placeholder-val="{{ false }}">
  <div style="position:absolute;top:44px;left:0;right:0;bottom:0;z-index:70;background:#F7F6F2;display:flex;flex-direction:column;animation:sb-rise .3s cubic-bezier(.16,1,.3,1)">

    <div style="flex-shrink:0;display:flex;align-items:center;gap:10px;padding:2px 14px 6px">
      <button onClick="{{ mini.minimize }}" style="width:32px;height:32px;border-radius:10px;border:1px solid #E4E1D8;background:#fff;display:flex;align-items:center;justify-content:center;flex-shrink:0" style-active="transform:scale(.92)">
        <svg viewBox="0 0 24 24" style="width:15px;height:15px;fill:none;stroke:#4F4B40;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round"><path d="M6 9.5l6 6 6-6"></path></svg>
      </button>
      <div style="flex:1;min-width:0;text-align:center">
        <div style="font-size:9.5px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#8A8578">En écoute</div>
        <div style="font-size:11.5px;font-weight:600;color:#4F4B40;margin-top:1px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{ mini.course }}</div>
      </div>
      <button onClick="{{ mini.openCourse }}" style="width:32px;height:32px;border-radius:10px;border:1px solid #E4E1D8;background:#fff;display:flex;align-items:center;justify-content:center;flex-shrink:0" style-active="transform:scale(.92)">
        <svg viewBox="0 0 24 24" style="width:15px;height:15px;fill:none;stroke:#4F4B40;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round"><path d="M4 6.5h2M4 12h2M4 17.5h2"></path><path d="M9.5 6.5h10M9.5 12h10M9.5 17.5h10"></path></svg>
      </button>
    </div>

    <div style="flex-shrink:0;display:flex;justify-content:center;padding:6px 20px 0">
      <div style="width:206px;height:206px;background:#1A1610;border-radius:20px;padding:16px;display:flex;flex-direction:column;justify-content:space-between;box-shadow:0 22px 40px -22px rgba(26,22,16,.85)">
        <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:10px">
          <svg viewBox="0 0 24 24" style="width:19px;height:19px;fill:none;stroke:#E3C063;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0"><path d="{{ mini.catD }}"></path><path d="{{ mini.catD2 }}"></path></svg>
          <div style="font-size:9px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,255,255,.38);text-align:right;line-height:1.3">{{ mini.src }}</div>
        </div>
        <div>
          <div style="font-family:'Fraunces',Georgia,serif;font-size:48px;font-weight:600;letter-spacing:-0.025em;line-height:1;color:#fff;font-variant-numeric:tabular-nums">{{ mini.lessonN }}</div>
          <div style="width:26px;height:2px;background:#B08D4F;margin:11px 0 9px"></div>
          <div style="font-size:9.5px;font-weight:700;letter-spacing:0.09em;text-transform:uppercase;color:#E3C063">Leçon sur {{ mini.lessonTotal }}</div>
        </div>
      </div>
    </div>

    <div style="flex-shrink:0;padding:15px 24px 0;text-align:center">
      <div style="font-family:'Fraunces',Georgia,serif;font-size:19px;font-weight:600;letter-spacing:-0.015em;line-height:1.3;text-wrap:pretty">{{ mini.title }}</div>
    </div>

    <div style="flex-shrink:0;padding:14px 22px 0">
      <input type="range" min="0" max="{{ mini.durSec }}" value="{{ mini.posSec }}" onChange="{{ mini.seek }}" />
      <div style="display:flex;align-items:center;justify-content:space-between;padding-top:7px">
        <span style="font-size:10.5px;font-weight:700;color:#4F4B40;font-variant-numeric:tabular-nums">{{ mini.pos }}</span>
        <span style="font-size:10.5px;font-weight:700;color:#A8A399;font-variant-numeric:tabular-nums">{{ mini.remain }}</span>
      </div>
    </div>

    <div style="flex-shrink:0;display:flex;align-items:center;justify-content:center;gap:12px;padding:12px 20px 0">
      <button onClick="{{ mini.prevLesson }}" style="width:38px;height:38px;border-radius:11px;border:1px solid #E4E1D8;background:#fff;display:flex;align-items:center;justify-content:center;flex-shrink:0;opacity:{{ mini.prevOp }}" style-active="transform:scale(.92)">
        <svg viewBox="0 0 24 24" style="width:15px;height:15px;fill:#4F4B40"><path d="M18 6v12l-9-6z"></path><path d="M6.5 5.5h2v13h-2z"></path></svg>
      </button>
      <button onClick="{{ mini.back }}" style="height:38px;padding:0 11px;border-radius:11px;border:1px solid #E4E1D8;background:#fff;color:#4F4B40;font-size:11.5px;font-weight:700;flex-shrink:0;font-variant-numeric:tabular-nums" style-active="transform:scale(.94)">−15 s</button>
      <button onClick="{{ mini.toggle }}" style="width:62px;height:62px;border-radius:100px;border:none;background:var(--sb-a);display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:0 14px 26px -12px rgba(14,124,90,.9)" style-active="transform:scale(.94)">
        <svg viewBox="0 0 24 24" style="width:24px;height:24px;fill:#fff"><path d="{{ mini.playD }}"></path></svg>
      </button>
      <button onClick="{{ mini.fwd }}" style="height:38px;padding:0 11px;border-radius:11px;border:1px solid #E4E1D8;background:#fff;color:#4F4B40;font-size:11.5px;font-weight:700;flex-shrink:0;font-variant-numeric:tabular-nums" style-active="transform:scale(.94)">+15 s</button>
      <button onClick="{{ mini.nextLesson }}" style="width:38px;height:38px;border-radius:11px;border:1px solid #E4E1D8;background:#fff;display:flex;align-items:center;justify-content:center;flex-shrink:0;opacity:{{ mini.nextOp }}" style-active="transform:scale(.92)">
        <svg viewBox="0 0 24 24" style="width:15px;height:15px;fill:#4F4B40"><path d="M6 6v12l9-6z"></path><path d="M15.5 5.5h2v13h-2z"></path></svg>
      </button>
    </div>

    <div style="flex-shrink:0;display:flex;align-items:center;justify-content:center;gap:8px;padding:12px 20px 2px">
      <button onClick="{{ mini.cycleRate }}" style="display:flex;align-items:center;gap:6px;height:32px;padding:0 13px;border-radius:100px;border:1px solid #E4E1D8;background:#fff;color:#4F4B40;font-size:11.5px;font-weight:700;font-variant-numeric:tabular-nums">Vitesse {{ mini.rateLabel }}</button>
      <button onClick="{{ mini.goNotes }}" style="display:flex;align-items:center;gap:6px;height:32px;padding:0 13px;border-radius:100px;border:1px solid #EADFC4;background:#F7EFDD;color:#8A5E1F;font-size:11.5px;font-weight:700">
        <svg viewBox="0 0 24 24" style="width:13px;height:13px;fill:none;stroke:#8A5E1F;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0"><path d="M6.5 3.5h7.5l4.5 4.5v12h-12z"></path><path d="M9.5 12.5h6M9.5 16h4"></path></svg>
        Horodater
      </button>
    </div>

    <div style="flex:1;overflow-y:auto;min-height:0;padding:16px 18px 22px">
      <div style="background:#F7EFDD;border:1px solid #EADFC4;border-radius:13px;padding:11px 13px 11px 11px;display:flex;gap:10px;margin-bottom:16px">
        <div style="width:2px;border-radius:100px;background:#DCC68C;flex-shrink:0"></div>
        <div style="flex:1;min-width:0">
          <div style="font-size:11.5px;font-weight:500;color:#5F4715;line-height:1.55;text-wrap:pretty">{{ mini.hadith }}</div>
          <div style="font-size:10px;font-weight:700;color:#A08341;margin-top:5px">{{ mini.hadithSrc }}</div>
        </div>
      </div>
      <div style="font-size:10.5px;font-weight:700;letter-spacing:0.09em;text-transform:uppercase;color:#8A8578;padding:0 2px 9px">À la suite</div>
      <div style="background:#fff;border:1px solid #E4E1D8;border-radius:14px;overflow:hidden">
        <sc-for list="{{ mini.queue }}" as="q" hint-placeholder-count="6">
          <button onClick="{{ q.play }}" style="width:100%;border:none;padding:11px 13px;text-align:left;display:flex;align-items:center;gap:11px;border-bottom:{{ q.divider }};background:{{ q.rowBg }}">
            <div style="width:28px;height:28px;border-radius:9px;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:10.5px;font-weight:700;font-variant-numeric:tabular-nums;background:{{ q.numBg }};color:{{ q.numInk }}">{{ q.n }}</div>
            <div style="flex:1;min-width:0">
              <div style="font-size:13px;font-weight:600;letter-spacing:-0.012em;line-height:1.25;color:{{ q.ink }}">{{ q.title }}</div>
              <div style="font-size:10.5px;font-weight:600;color:#A8A399;margin-top:2px;font-variant-numeric:tabular-nums">{{ q.dur }}</div>
            </div>
            <svg viewBox="0 0 24 24" style="width:15px;height:15px;fill:none;stroke:var(--sb-a);stroke-width:2.6;stroke-linecap:round;flex-shrink:0;display:{{ q.checkShow }}"><path d="M5 13l4 4L19 7"></path></svg>
          </button>
        </sc-for>
      </div>
    </div>

  </div>
  </sc-if>

  <!-- ═══════════ COURS ═══════════ -->
  <sc-if value="{{ isCourse }}" hint-placeholder-val="{{ false }}">
  <div style="flex:1;display:flex;flex-direction:column;min-height:0">

    <div style="flex-shrink:0;padding:2px 16px 12px">
      <div style="display:flex;align-items:flex-start;gap:10px">
        <button onClick="{{ cs.close }}" style="width:30px;height:30px;border-radius:9px;border:1px solid #E4E1D8;background:#fff;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px">
          <svg viewBox="0 0 24 24" style="width:14px;height:14px;fill:none;stroke:#4F4B40;stroke-width:2.5;stroke-linecap:round"><path d="M15 18l-6-6 6-6"></path></svg>
        </button>
        <div style="flex:1;min-width:0">
          <div style="font-family:'Fraunces',Georgia,serif;font-size:19px;font-weight:600;letter-spacing:-0.015em;line-height:1.2">{{ cs.name }}</div>
          <div style="font-size:11.5px;font-weight:600;color:#8A8578;margin-top:3px">{{ cs.meta }}</div>
        </div>
      </div>
      <div style="display:flex;align-items:center;gap:10px;margin-top:12px">
        <div style="flex:1;min-width:0;height:5px;background:#EFEDE6;border-radius:100px;overflow:hidden">
          <div style="height:100%;background:var(--sb-a);border-radius:100px;width:{{ cs.pct }}"></div>
        </div>
        <div style="font-size:11px;font-weight:700;color:#4F4B40;font-variant-numeric:tabular-nums;flex-shrink:0">{{ cs.progLabel }}</div>
      </div>
    </div>

    <div style="flex-shrink:0;padding:0 16px 12px">
      <div style="display:flex;background:#EFEDE6;border-radius:11px;padding:3px;gap:2px">
        <sc-for list="{{ cs.tabs }}" as="t" hint-placeholder-count="4">
          <button onClick="{{ t.pick }}" style="flex:1;border:none;padding:8px 2px;border-radius:8px;display:flex;flex-direction:column;align-items:center;gap:3px;position:relative;background:{{ t.bg }};box-shadow:{{ t.shadow }}">
            <svg viewBox="0 0 24 24" style="width:15px;height:15px;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;stroke:{{ t.ink }}"><path d="{{ t.d }}"></path><path d="{{ t.d2 }}"></path></svg>
            <span style="font-size:10px;font-weight:700;color:{{ t.ink }}">{{ t.label }}</span>
            <svg viewBox="0 0 24 24" style="position:absolute;top:4px;right:6px;width:9px;height:9px;fill:none;stroke:#C9C4B4;stroke-width:2.4;stroke-linecap:round;display:{{ t.lockShow }}"><path d="M5.5 11h13v9.5h-13z"></path><path d="M8.5 11V8a3.5 3.5 0 017 0v3"></path></svg>
          </button>
        </sc-for>
      </div>
    </div>

    <div style="flex:1;overflow-y:auto;min-height:0;padding:0 16px 96px">

      <sc-if value="{{ cs.isAudio }}" hint-placeholder-val="{{ true }}">
        <button onClick="{{ cs.playAll }}" style="width:100%;background:#1A1610;border:none;border-radius:14px;padding:13px 14px;display:flex;align-items:center;gap:12px;text-align:left;color:#fff;margin-bottom:12px">
          <div style="width:38px;height:38px;border-radius:11px;background:var(--sb-a);display:flex;align-items:center;justify-content:center;flex-shrink:0">
            <svg viewBox="0 0 24 24" style="width:16px;height:16px;fill:#fff"><path d="M7 4.5v15l12-7.5z"></path></svg>
          </div>
          <div style="flex:1;min-width:0">
            <div style="font-size:10px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:rgba(255,255,255,.5)">Audio du cours</div>
            <div style="font-size:13.5px;font-weight:600;letter-spacing:-0.012em;margin-top:2px">{{ cs.playAllLabel }}</div>
          </div>
        </button>

        <div style="background:#fff;border:1px solid #E4E1D8;border-radius:14px;overflow:hidden">
          <sc-for list="{{ cs.lessons }}" as="l" hint-placeholder-count="6">
            <div style="display:flex;align-items:stretch;border-bottom:{{ l.divider }};background:{{ l.rowBg }}">
              <button onClick="{{ l.play }}" style="flex:1;min-width:0;border:none;background:none;padding:11px 2px 11px 13px;text-align:left">
                <div style="display:flex;align-items:center;gap:11px">
                  <div style="width:28px;height:28px;border-radius:9px;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:10.5px;font-weight:700;font-variant-numeric:tabular-nums;background:{{ l.numBg }};color:{{ l.numInk }}">{{ l.n }}</div>
                  <div style="flex:1;min-width:0">
                    <div style="font-size:13px;font-weight:600;letter-spacing:-0.012em;line-height:1.3;color:{{ l.nameInk }};text-wrap:pretty">{{ l.title }}</div>
                    <div style="display:flex;align-items:center;gap:8px;margin-top:3px">
                      <span style="font-size:10.5px;font-weight:600;color:#A8A399;font-variant-numeric:tabular-nums;display:{{ l.durShow }}">{{ l.dur }}</span>
                      <span style="font-size:10.5px;font-weight:700;color:#8A5E1F;font-variant-numeric:tabular-nums;display:{{ l.resumeShow }}">{{ l.resumeLabel }}</span>
                    </div>
                  </div>
                  <svg viewBox="0 0 24 24" style="width:14px;height:14px;fill:#C9C4B4;flex-shrink:0;display:{{ l.playShow }}"><path d="M7.5 5v14l11-7z"></path></svg>
                </div>
                <div style="height:3px;background:#E4E1D8;border-radius:100px;overflow:hidden;margin:9px 0 1px;display:{{ l.barShow }}">
                  <div style="height:100%;background:var(--sb-a);border-radius:100px;width:{{ l.barPct }};transition:width .95s linear"></div>
                </div>
              </button>
              <button onClick="{{ l.toggleDone }}" style="flex-shrink:0;width:42px;border:none;background:none;display:flex;align-items:center;justify-content:center" style-active="transform:scale(.9)">
                <div style="width:22px;height:22px;border-radius:100px;border:1.5px solid;display:flex;align-items:center;justify-content:center;background:{{ l.checkBg }};border-color:{{ l.checkBorder }}">
