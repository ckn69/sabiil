  }

  // Normalisation : 15 lignes, découpage d'origine, marqueurs de fin d'āyah,
  // lignes d'en-tête de sourate et de basmalah déduites des lignes vides du mushaf.
  qmNorm(p, j, src) {
    var vs = j.verses || [], L = {}, i;
    for (i = 1; i <= 15; i++) L[i] = [];
    vs.forEach(function (v) {
      (v.words || []).forEach(function (w) {
        var ln = w.line_number || 1;
        if (!L[ln]) L[ln] = [];
        L[ln].push({ t: w.text_uthmani || w.text || '', end: w.char_type_name === 'end', key: v.verse_key, n: v.verse_number, s: v.chapter_id, pos: w.position });
      });
    });
    var head = {};
    vs.forEach(function (v) {
      if (v.verse_number !== 1 || !v.words || !v.words.length) return;
      var l = v.words[0].line_number || 1;
      var basm = l - 1 >= 1 && (!L[l - 1] || !L[l - 1].length);
      var hd = l - 2 >= 1 && (!L[l - 2] || !L[l - 2].length);
      if (basm && hd) { head[l - 2] = { type: 'surah', s: v.chapter_id }; head[l - 1] = { type: 'basmalah', s: v.chapter_id }; }
      else if (basm) { head[l - 1] = { type: 'surah', s: v.chapter_id }; }
    });
    var lines = [];
    for (i = 1; i <= 15; i++) {
      var h = head[i];
      if (h) lines.push({ i: i, type: h.type, s: h.s, words: [] });
      else lines.push({ i: i, type: (L[i] && L[i].length) ? 'text' : 'blank', words: L[i] || [] });
    }
    return {
      p: p, lines: lines, src: src || 'quran.com · QPC Ḥafṣ',
      juz: vs.length ? vs[0].juz_number : this.juzAt(p),
