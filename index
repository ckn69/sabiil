      }
      if (ed) {
        var edRole = ed.role || 'membre';
        gd.editOpen = true;
        gd.edit = {
          name: ed.name, initial: ed.initial, color: ed.color, status: ed.status,
          roleLabel: ROLE[edRole].label,
          roles: ['resp', 'mod', 'membre'].map(function (k) {
            var on = edRole === k;
            return {
              label: ROLE[k].label, d: self.IC[ROLE[k].ic][0], d2: self.IC[ROLE[k].ic][1],
              bg: on ? '#1A1610' : '#FFFFFF', ink: on ? '#FFFFFF' : '#4F4B40',
              border: on ? '#1A1610' : '#E4E1D8',
              sub: k === 'resp' ? 'Gère les membres et les grades' : (k === 'mod' ? 'Invite et modère le fil' : 'Participe aux blocs'),
              subInk: on ? 'rgba(255,255,255,.62)' : '#A8A399',
              pick: function () {
                ed.role = k === 'membre' ? null : k;
                self.setState({ roleEdit: null });
                self.toast(ed.name + ' · ' + ROLE[k].label);
              }
            };
          }),
          remove: function () {
            var r = Object.assign({}, st.removed);
            r[gcur.id + '|' + ed.id] = true;
            self.setState({ removed: r, roleEdit: null });
            self.toast(ed.name + ' retiré du groupe');
          },
          close: function () { self.setState({ roleEdit: null }); }
        };
      }
    }

    // ── assistant ──
    var AM = [{ k: 'coran', l: 'Coran' }, { k: 'hadith', l: 'Hadiths' }, { k: 'fatwa', l: 'Fatwas' }];
    var aiModes = AM.map(function (m) {
      var on = st.aiMode === m.k;
      return {
        label: m.l, bg: on ? '#FFFFFF' : 'transparent', ink: on ? '#1A1610' : '#8A8578',
        shadow: on ? '0 1px 3px rgba(26,22,16,.1)' : 'none',
        pick: function () { self.setState({ aiMode: m.k }); }
      };
    });
    var aiData = this.AI[st.aiMode] || [];
    var q = (st.aiQuery || '').trim().toLowerCase();
    var matches = aiData;
    if (q) {
      matches = aiData.filter(function (r) {
        var hay = [r.ref, r.trad, r.explain, r.question, r.answer, r.scholar, r.meta]
          .concat(r.keywords || []).filter(Boolean).join(' ').toLowerCase();
        return hay.indexOf(q) !== -1;
      });
    }
    var BADGE = { coran: { bg: 'var(--sb-abg)', ink: 'var(--sb-ai)', txt: 'ق' }, hadith: { bg: '#E4EBF5', ink: '#2F5382', txt: 'ح' }, fatwa: { bg: '#F7EFDD', ink: '#8A5E1F', txt: '' } };
    var aiResults = matches.map(function (r) {
      var b = BADGE[st.aiMode];
      var isFatwa = st.aiMode === 'fatwa';
      return {
        badge: isFatwa ? r.initials : b.txt, badgeBg: b.bg, badgeInk: b.ink,
        ref: isFatwa ? r.scholar : r.ref, refInk: b.ink,
        meta: r.meta || '', metaShow: r.meta ? 'block' : 'none',
        hasArabic: !!r.arabic, arabic: r.arabic || '',
        hasQuestion: !!r.question, question: r.question || '',
        body: self.seg(r.trad || r.answer || ''),
        explain: r.explain || '', explainShow: r.explain ? 'block' : 'none',
        saveNote: function () {
          var ttl = (isFatwa ? r.scholar : r.ref) || 'Note';
          var bd = (r.arabic ? r.arabic + '\n\n' : '') + (r.question ? r.question + '\n\n' : '') + (r.trad || r.answer || '');
          self.ntAdd(ttl, bd);
          self.toast('Enregistré dans Notes');
        },
        copy: function () { self.toast('Copié'); }
      };
    });
    var aiChips = this.CHIPS.map(function (c) {
      return { label: c, pick: function () { self.setState({ aiQuery: c }); } };
    });

    // ── conflits avec les plages de prière ──
    var conflictOf = function (e) {
      for (var i = 0; i < bandList.length; i++) {
        var b = bandList[i];
        if (e.s < b.b && e.e > b.a) return b;
      }
      return null;
    };
    var cycD = (st.womenMode && st.cycle.active && st.cycle.startKey)
      ? Math.round((this.pd(dayKey) - this.pd(st.cycle.startKey)) / 86400000) + 1 : 0;
    var cycleOn = cycD >= 1 && cycD <= st.cycle.days;
    var conflicts = cycleOn ? [] : allEvents.filter(function (e) { return !!conflictOf(e); });
    if (!cycleOn) {
      eventBlocks.forEach(function (b) {
        if (conflictOf(b.evRef)) { b.ring = 'inset 0 0 0 1.5px #C0492F'; b.alertShow = 'flex'; }
      });
    }

    // ── créneaux libres > 20 min ──
    var busy = bandList.map(function (b) { return { s: b.a, e: b.b }; })
      .concat(allEvents.map(function (e) { return { s: e.s, e: e.e }; }))
      .sort(function (a, b) { return a.s - b.s; });
    var merged = [];
    busy.forEach(function (x) {
      var last = merged[merged.length - 1];
      if (last && x.s <= last.e) last.e = Math.max(last.e, x.e);
      else merged.push({ s: x.s, e: x.e });
    });
    var gaps = [];
    var cursor = 0;
    merged.forEach(function (b) {
      if (b.s - cursor >= 20) gaps.push({ s: cursor, e: b.s });
      cursor = Math.max(cursor, b.e);
    });
    if (1440 - cursor >= 20) gaps.push({ s: cursor, e: 1440 });

    // une seule suggestion par type, priorisée par les habitudes non faites du jour
    var undoneHabits = this.HAB.filter(function (h) { return !st.hd[h.id]; });
    var wanted = {};
    undoneHabits.forEach(function (h) {
      var s = self.HABIT_SUGGEST[h.id];
      if (s) wanted[s.k] = { name: s.name, title: s.title, habit: h.name, streak: h.streak };
    });
    var alreadyPlanned = function (nm) {
      return allEvents.some(function (e) { return e.name.toLowerCase() === nm.toLowerCase(); });
    };

    var seen = {}, gapCards = [];
    gaps.forEach(function (g) {
      var pick = null;
      for (var i = 0; i < self.GAP_SUGGEST.length; i++) {
        var s = self.GAP_SUGGEST[i];
        if (g.s >= s.from && g.s < s.to) pick = s;
      }
      if (!pick) return;
      if (seen[pick.id]) return;
      var key = dayKey + '|' + pick.id;
      if (st.gapsOff[key]) { seen[pick.id] = true; return; }
      var w = wanted[pick.k];
      var name = w ? w.name : pick.name;
      if (alreadyPlanned(name)) { seen[pick.id] = true; return; }
      seen[pick.id] = true;
      var mins = g.e - g.s;
      var dur = Math.min(mins, Math.max(pick.min, Math.min(45, mins)));
      var a = ACT[pick.k];
      gapCards.push({
        key: key, prio: w ? 0 : 1,
        slot: self.hhmm(g.s) + ' – ' + self.hhmm(g.e) + ' · ' + mins + ' min',
        name: name, title: w ? w.title : pick.title,
        reasonShow: w ? 'block' : 'none',
        reason: w ? 'Ton habitude « ' + w.habit + ' » n\'est pas encore faite · série de ' + w.streak + ' j' : '',
        hadith: '« ' + pick.hadith + ' »', src: pick.src,
        d: self.IC[a.ic][0], d2: self.IC[a.ic][1],
        add: function () {
          self.addEvent(dayKey, { id: Date.now(), name: name, s: g.s, e: g.s + dur, cat: a.cat, ic: a.ic });
          var off = Object.assign({}, st.gapsOff); off[key] = true;
          self.setState({ gapsOff: off });
          self.toast(name + ' · ' + self.hhmm(g.s) + ' → ' + self.hhmm(g.s + dur));
        },
        skip: function () { var off = Object.assign({}, st.gapsOff); off[key] = true; self.setState({ gapsOff: off }); }
      });
    });
    gapCards.sort(function (a, b) { return a.prio - b.prio; });

    // ── bilan de fin de journée ──
    var undone = sortedEvents.filter(function (e) { return !st.done[e.key]; });
    var reviewDone = sortedEvents.length - undone.length;
    var groupPrayers = 0;
    Object.keys(st.ps).forEach(function (k) { if (st.ps[k] === 'group' || st.ps[k] === 'mosque') groupPrayers++; });
    var reviewRows = sortedEvents.map(function (e) {
      var d = !!st.done[e.key];
      var t = self.tint(e.cat);
      return {
        name: e.name, time: self.hhmm(e.s),
        bg: d ? 'var(--sb-abg)' : '#F7E4DE', ink: d ? 'var(--sb-ai)' : '#A33D25',
        mark: d ? 'M5 13l4 4L19 7' : 'M6 6l12 12M18 6L6 18',
        nameInk: d ? '#8A8578' : '#1A1610', deco: d ? 'line-through' : 'none'
      };
    });

    // ── vue chronologie ──
    var tlItems = [];
    var tlMix = sortedEvents.map(function (e) { return { kind: 'ev', s: e.s, e: e.e, o: e }; })
      .concat(bandList.map(function (b) { return { kind: 'pr', s: b.a, e: b.b, o: b }; }))
      .sort(function (a, b) { return a.s - b.s; });
    tlMix.forEach(function (x) {
      if (x.kind === 'pr') {
        var s = STY[st.ps[x.o.n]] || STY.pending;
        tlItems.push({
          time: self.hhmm(x.o.a), name: x.o.n, meta: 'Plage réservée · ' + (x.o.b - x.o.a) + ' min',
          bg: 'var(--sb-abg)', ink: 'var(--sb-ai)', bar: 'var(--sb-a)', d: self.IC.mosquee[0], d2: self.IC.mosquee[1],
          badge: st.ps[x.o.n] === 'mosque' ? 'À la mosquée' : (st.ps[x.o.n] === 'group' ? 'En groupe' : (st.ps[x.o.n] === 'alone' ? 'Seul' : '')),
          open: function () { self.cycle(x.o.n); }
        });
      } else {
        var e = x.o, t = self.tint(e.cat), d = !!st.done[e.key];
        var mn = e.e - e.s;
        tlItems.push({
          time: self.hhmm(e.s), name: e.name,
          meta: e.catLabel + ' · ' + (mn >= 60 ? (mn % 60 === 0 ? mn / 60 + 'h' : Math.floor(mn / 60) + 'h' + (mn % 60)) : mn + ' min'),
          bg: t.bg, ink: t.ink, bar: t.bar, d: self.IC[e.ic][0], d2: self.IC[e.ic][1],
          badge: d ? 'Fait' : (conflictOf(e) ? 'Conflit prière' : ''),
          open: function () { self.setState({ detail: { dk: dayKey, id: e.id } }); }
        });
      }
    });

    // ── recherche mosquée (Mawaqit) ──
    var mqq = (st.mq || '').trim().toLowerCase();
    var mosqueHits = this.MOSQUES.filter(function (m) {
      if (!mqq) return true;
      return (m.name + ' ' + m.city).toLowerCase().indexOf(mqq) !== -1;
    }).map(function (m) {
      var on = m.id === st.mosque;
      return {
        name: m.name, city: m.city, dist: m.dist,
        fajr: self.hhmm(m.times[0].m), isha: self.hhmm(m.times[4].m),
        bg: on ? 'var(--sb-abg)' : '#FFFFFF', border: on ? 'var(--sb-a)' : '#E4E1D8',
        checkShow: on ? 'flex' : 'none',
        pick: function () { self.setState({ mosque: m.id, modal: '' }); self.toast(m.name + ' · horaires synchronisés'); }
      };
    });

    // ── calques enfants ──
    var kidsFeature = st.kidsFeature !== false;
    var kidsActive = st.kidsOn && kidsFeature;
    var kidFocus = st.kidFocus || null;
    if (kidFocus && !this.KIDS.some(function (k) { return k.id === kidFocus; })) kidFocus = null;
    var kidChips = this.KIDS.map(function (k) {
      var on = kidsActive && kidFocus === k.id;
      return {
        name: k.name, initial: k.initial, color: k.color,
        pad: on ? '3px 12px 3px 3px' : '3px',
        nameShow: on ? 'block' : 'none',
        dim: kidsActive ? '1' : '.4',
        bg: on ? k.color + '1F' : 'transparent', ink: on ? '#1A1610' : '#8A8578',
        toggle: function () {
          self.setState({ kidFocus: kidFocus === k.id ? null : k.id, kidsOn: true });
        }
      };
    });
    var KIDPAL = ['#B5638A', '#3E6BA8', '#4E8C6A', '#A8723A', '#7A5BA8', '#C0492F'];
    var kidRows = this.KIDS.map(function (k) {
      var sexLabel = k.sex === 'f' ? 'Fille' : (k.sex === 'g' ? 'Garçon' : '');
      return {
        name: k.name, initial: k.initial, color: k.color,
        sub: (sexLabel ? sexLabel + ' · ' : '') + (k.age ? k.age + ' ans · ' : '') + k.blocks.length + (k.blocks.length > 1 ? ' blocs' : ' bloc'),
        editShow: st.kidEdit === k.id ? 'flex' : 'none',
        editColor: function () { self.setState({ kidEdit: st.kidEdit === k.id ? null : k.id }); },
        swatches: KIDPAL.map(function (hex) {
          return {
            hex: hex, ring: k.color === hex ? '#1A1610' : 'transparent',
            pick: function () { k.color = hex; self.setState({ kidEdit: null }); }
          };
        }),
        remove: function () {
          self.KIDS = self.KIDS.filter(function (x) { return x.id !== k.id; });
          var sh = Object.assign({}, st.kidsShown); delete sh[k.id];
          self.setState({ kidsShown: sh });
          self.toast(k.name + ' retiré');
        }
      };
    });
    // un seul enfant à la fois sur la grille : la largeur de la colonne principale ne
    // bouge jamais. Sans enfant sélectionné, leurs blocs restent visibles en fines
    // marques sur le bord droit, tapables pour ouvrir la voie correspondante.
    var focusKid = kidsActive && kidFocus ? this.KIDS.filter(function (k) { return k.id === kidFocus; })[0] : null;

    function kidBlockVM(k, b) {
          var dur = b.e - b.s;
          var kOn = !!(st.adj && st.adj.kind === 'kid' && st.adj.kidId === k.id && st.adj.id === b.id);
          return {
            left: '3px', w: 'calc(100% - 4px)', tag: '', color: k.color,
            tagShow: 'none',
            name: b.name, top: self.px(b.s), h: ((b.e - b.s) / 60 * self.HH).toFixed(1) + 'px',
            range: self.hhmm(b.s) + ' – ' + self.hhmm(b.e),
            opacity: kOn ? '1' : '.82',
            z: kOn ? '8' : '1',
            sel: kOn ? '#1A1610' : 'transparent',
            hndShow: kOn ? 'flex' : 'none',
            cursor: kOn ? 'grab' : 'pointer',
            touch: kOn ? 'none' : 'pan-y',
            fs: dur < 40 ? '9px' : '10px',
            pad: dur < 30 ? '2px 4px' : '4px 5px',
            wrap: dur < 30 ? 'nowrap' : 'normal',
            ell: dur < 30 ? 'ellipsis' : 'clip',
            brk: dur < 30 ? 'normal' : 'break-word',
            startLabel: self.hhmm(b.s),
            timeShow: dur >= 45 ? 'block' : 'none',
            stop: function (ev) { ev.stopPropagation(); },
            press: function (ev) {
              if (kOn) { self.kidDrag(ev, k, b, 'move'); return; }
              self.longPress(ev, function () { self.toggleAdj({ kind: 'kid', kidId: k.id, id: b.id }); });
            },
            resize: function (ev) { self.kidDrag(ev, k, b, 'resize'); },
            dbl: function (ev) {
              ev.preventDefault(); ev.stopPropagation();
              self.setState({ kdet: { kidId: k.id, id: b.id }, detail: null, adj: null });
            }
          };
    }

    var kidLanes = focusKid ? [{
      initial: focusKid.initial, color: focusKid.color, name: focusKid.name,
      laneW: '58px', laneBg: focusKid.color + '14',
      blocks: focusKid.blocks.map(function (b) { return kidBlockVM(focusKid, b); })
    }] : [];

    var kidTicks = [];
    if (kidsActive && !focusKid) {
      this.KIDS.forEach(function (k) {
        k.blocks.forEach(function (b) {
          kidTicks.push({
            color: k.color, top: self.px(b.s),
            h: Math.max(6, (b.e - b.s) / 60 * self.HH).toFixed(1) + 'px',
            focus: function () { self.setState({ kidFocus: k.id, kidsOn: true }); }
          });
        });
      });
    }

    var laneTotal = focusKid ? 62 : (kidTicks.length ? 14 : 0);

    // ── fiche détail d'un bloc enfant (double-clic) ──
    var kdet = null;
    if (st.kdet) {
      var kk = null, kb = null;
      this.KIDS.forEach(function (k) {
        if (k.id !== st.kdet.kidId) return;
        kk = k;
        k.blocks.forEach(function (b) { if (b.id === st.kdet.id) kb = b; });
      });
      if (kk && kb) {
        var kt = this.tint(kb.cat), km = CM[kb.cat] || CM.travail, ka = this.actFor(kb);
        var kmin = kb.e - kb.s, krl = this.remLabel(kb.rem);
        kdet = {
          name: kb.name, kidColor: kk.color, kidInitial: kk.initial,
          sub: 'Agenda de ' + kk.name + ' · ' + km.label,
          bg: kt.bg, ink: kt.ink,
          d: this.IC[kb.ic || km.ic][0], d2: this.IC[kb.ic || km.ic][1],
          range: this.hhmm(kb.s) + ' – ' + this.hhmm(kb.e),
          dur: kmin >= 60 ? (kmin % 60 === 0 ? Math.floor(kmin / 60) + 'h' : Math.floor(kmin / 60) + 'h' + (kmin % 60)) : kmin + ' min',
          loc: kb.loc || '', locShow: kb.loc ? 'flex' : 'none',
          locDiv: (kb.loc && krl) ? '1px solid #EFEDE6' : 'none',
          remLabel: krl || '', remShow: krl ? 'flex' : 'none',
          metaShow: (kb.loc || krl) ? 'flex' : 'none',
          hadith: ka ? { title: ka.title, text: '« ' + ka.hadith + ' »', src: ka.src } : null
        };
      }
    }

    // ── panneau du bloc déverrouillé (aperçu + infos générales de l'activité) ──
    var adjP = { show: 'none', chips: [], name: '', sub: '', bg: '#F1F0EA', ink: '#6B6759', d: '', d2: '',
      hadShow: 'none', hadTitle: '', hadText: '', hadSrc: '', durLabel: '',
      close: function () {}, keep: function () { self.adjKeep(); } };
    if (st.adj) {
      var asrc = null, aown = 'Mon agenda';
      if (st.adj.kind === 'ev') {
        for (var qi = 0; qi < allEvents.length; qi++) if (allEvents[qi].id === st.adj.id) asrc = allEvents[qi];
      } else {
        this.KIDS.forEach(function (k) {
          if (k.id !== st.adj.kidId) return;
          aown = 'Agenda de ' + k.name;
          k.blocks.forEach(function (b) { if (b.id === st.adj.id) asrc = b; });
        });
      }
      if (asrc) {
        var at = this.tint(asrc.cat), am = CM[asrc.cat] || CM.travail, aa = this.actFor(asrc);
        var amin = asrc.e - asrc.s;
        var ach = [{ label: 'Créneau', val: this.hhmm(asrc.s) + ' – ' + this.hhmm(asrc.e) },
          { label: 'Durée', val: amin >= 60 ? (amin % 60 === 0 ? (amin / 60) + ' h' : Math.floor(amin / 60) + ' h ' + (amin % 60)) : amin + ' min' }];
        if (asrc.loc) ach.push({ label: 'Lieu', val: asrc.loc });
        var arl = this.remLabel(asrc.rem);
        if (arl) ach.push({ label: 'Rappel', val: arl });
        if (asrc.grp) ach.push({ label: 'Groupe', val: asrc.grp });
        adjP = {
          show: 'block', name: asrc.name, sub: aown + ' · ' + am.label,
          bg: at.bg, ink: at.ink,
          d: this.IC[asrc.ic || am.ic][0], d2: this.IC[asrc.ic || am.ic][1],
          chips: ach.map(function (c, ci) {
            return { label: c.label, val: c.val, divider: ci === ach.length - 1 ? 'none' : '1px solid #EFEDE6' };
          }),
          hadShow: aa ? 'block' : 'none',
          hadTitle: aa ? aa.title : '', hadText: aa ? '« ' + aa.hadith + ' »' : '', hadSrc: aa ? aa.src : '',
          durLabel: aa ? 'Durée type ' + aa.dur + ' min · activité « ' + aa.label + ' »' : am.label,
          close: function () { self.setState({ adj: null }); },
          keep: function () { self.adjKeep(); }
        };
      }
    }

    var kidMemo = this.KIDS.map(function (k) {
      var done = st.memo[k.id];
      return {
        name: k.name, initial: k.initial, color: k.color, surah: k.surah,
        age: k.age + ' ans', label: done + ' / ' + k.total + ' versets',
        pct: Math.round(done / k.total * 100) + '%',
        validate: function () {
          if (done >= k.total) { self.toast(k.name + ' a terminé ' + k.surah); return; }
          var m = Object.assign({}, st.memo); m[k.id] = done + 1;
          self.setState({ memo: m });
          self.toast(k.name + ' · verset ' + (done + 1) + ' validé');
        }
      };
    });

    // ── mode femme : cycle, tâches, charge ──
    var cyc = st.cycle;
    var cycleDay = cycD;

    if (cycleOn) {
      prayerBands.forEach(function (b) {
        b.bg = '#F5E5EE'; b.border = '#E6CFDC'; b.ink = '#98527A'; b.status = 'Dérogation';
      });
      dayCols.forEach(function (c) {
        c.bands.forEach(function (b) { b.bg = '#F5E5EE'; b.border = '#E6CFDC'; b.ink = '#98527A'; });
      });
    }

    var busyMin = merged.reduce(function (a, b) { return a + (b.e - b.s); }, 0);
    var wakeMin = 1440 - 420;
    var loadPct = Math.min(100, Math.round(busyMin / wakeMin * 100));
    var loadLevel = loadPct >= 85 ? 'high' : (loadPct >= 65 ? 'mid' : 'ok');
    var LOAD = {
      ok: { bg: 'var(--sb-abg)', border: 'var(--sb-abd)', ink: 'var(--sb-ai)', bar: 'var(--sb-a)', title: 'Journée équilibrée', sub: 'Il te reste de la marge pour l\'imprévu.' },
      mid: { bg: '#F7EFDD', border: '#EADFC4', ink: '#8A5E1F', bar: '#B08D4F', title: 'Journée chargée', sub: 'Garde une respiration entre deux blocs.' },
      high: { bg: '#F7E4DE', border: '#EDCEC5', ink: '#A33D25', bar: '#C0492F', title: 'Journée surchargée', sub: 'Allège : reporte un bloc non essentiel à demain.' }
    };
    var load = LOAD[loadLevel];

    // ── rapport hebdomadaire (vendredi) ──
    var wkKeys = this.weekKeys(dayKey);
    var catTotals = {};
    var wkDone = 0, wkAll = 0;
    wkKeys.forEach(function (k) {
      (st.events[k] || []).forEach(function (e) {
        wkAll++;
        if (st.done[k + '|' + e.id]) wkDone++;
        catTotals[e.cat] = (catTotals[e.cat] || 0) + (e.e - e.s);
      });
